---
import { getCollection } from "astro:content";
import path from "node:path";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getDir, getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { licenseConfig } from "src/config";
import ImageWrapper from "../../../components/misc/ImageWrapper.astro";
import PostMetadata from "../../../components/PostMeta.astro";
import Comment from "../../../components/widget/Comment.astro";
import TOC from "../../../components/widget/TOC.astro";
import { profileConfig, siteConfig } from "../../../config";
import { formatDateToYYYYMMDD } from "../../../utils/date-utils";

import "katex/dist/katex.css";

export async function getStaticPaths() {
	const allProjects = await getCollection("projects", ({ data }) => {
		return import.meta.env.PROD ? data.draft !== true : true;
	});

	const sorted = allProjects.sort((a, b) => {
		const dateA = new Date(a.data.published);
		const dateB = new Date(b.data.published);
		return dateA > dateB ? -1 : 1;
	});

	for (let i = 1; i < sorted.length; i++) {
		sorted[i].data.nextSlug = sorted[i - 1].slug;
		sorted[i].data.nextTitle = sorted[i - 1].data.title;
	}
	for (let i = 0; i < sorted.length - 1; i++) {
		sorted[i].data.prevSlug = sorted[i + 1].slug;
		sorted[i].data.prevTitle = sorted[i + 1].data.title;
	}

	return sorted.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const { remarkPluginFrontmatter } = await entry.render();

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
};
---

<MainGridLayout banner={entry.data.image} title={entry.data.title} description={entry.data.description} lang={entry.data.lang} setOGTypeArticle={true} headings={headings} showSidebarOnMobile={true}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div id="post-container" class="card-base z-10 px-9 pt-6 pb-4 relative w-full">
            <!-- Date (Subtle) -->
            <div class="flex items-center justify-center text-black/50 dark:text-white/50 mb-2 onload-animation">
                <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                    <Icon name="material-symbols:edit-calendar-rounded"></Icon>
                </div>
                <span class="text-sm font-medium">{formatDateToYYYYMMDD(entry.data.published)}</span>
            </div>

            <!-- title -->
            <div class="relative onload-animation">
                <div
                    data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                    class="transition w-full block font-semibold mb-3 text-center
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    [text-wrap:balance] break-keep
                ">
                    {entry.data.title}
                </div>
            </div>

            <!-- Project Links -->
            <div class="flex flex-row items-center justify-center text-lg mb-8 onload-animation text-90">
                {entry.data.github_url && (
                    <a href={entry.data.github_url} target="_blank" rel="noopener" class="flex items-center hover:text-[var(--primary)] transition-colors group/link px-4 py-4 -mx-4 -my-4 gap-2">
                        <Icon name="fa6-brands:github" class="text-xl"></Icon>
                        <span class="font-bold">GitHub</span>
                    </a>
                )}
                {entry.data.github_url && entry.data.demo_url && (
                    <span class="mx-4 text-black/20 dark:text-white/20">|</span>
                )}
                {entry.data.demo_url && (
                    <a href={entry.data.demo_url} target="_blank" rel="noopener" class="flex items-center hover:text-[var(--primary)] transition-colors group/link px-4 py-4 -mx-4 -my-4 gap-2">
                        <Icon name="material-symbols:open-in-new-rounded" class="text-xl"></Icon>
                        <span class="font-bold">Live Demo</span>
                    </a>
                )}
            </div>

            <div class="onload-animation">
                {!entry.data.image && <div class="border-[var(--line-divider)] border-dashed border-b-[3px] mb-7"></div>}
            </div>

            {entry.data.image &&
                <ImageWrapper id="post-cover" src={entry.data.image} basePath={path.join("content/projects/", getDir(entry.id))} class="mb-8 rounded-xl banner-container" loading="eager" fetchPriority="high"/>
            }

            {siteConfig.toc.enable && <div id="top-toc-container" class="mb-7 w-fit max-w-full md:max-w-[50%] onload-animation pb-0">
                <TOC headings={headings} class="!pl-0" isFloating={false}></TOC>
            </div>}

            <Markdown class="mb-6 markdown-content onload-animation">
                <Content />
            </Markdown>

            <!-- Project Links (Bottom) -->
            {(entry.data.github_url || entry.data.demo_url) && (
                <div class="flex flex-row items-center justify-center text-lg mb-8 mt-10 onload-animation text-90">
                    {entry.data.github_url && (
                        <a href={entry.data.github_url} target="_blank" rel="noopener" class="flex items-center hover:text-[var(--primary)] transition-colors group/link px-4 py-4 -mx-4 -my-4 gap-2">
                            <Icon name="fa6-brands:github" class="text-xl"></Icon>
                            <span class="font-bold">GitHub</span>
                        </a>
                    )}
                    {entry.data.github_url && entry.data.demo_url && (
                        <span class="mx-4 text-black/20 dark:text-white/20">|</span>
                    )}
                    {entry.data.demo_url && (
                        <a href={entry.data.demo_url} target="_blank" rel="noopener" class="flex items-center hover:text-[var(--primary)] transition-colors group/link px-4 py-4 -mx-4 -my-4 gap-2">
                            <Icon name="material-symbols:open-in-new-rounded" class="text-xl"></Icon>
                            <span class="font-bold">Live Demo</span>
                        </a>
                    )}
                </div>
            )}

            {licenseConfig.enable && <License title={entry.data.title} slug={entry.slug} pubDate={entry.data.published} class="mb-6 rounded-xl license-container onload-animation"></License>}

        </div>
    </div>

    <div class="flex flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
        <a href={entry.data.prevSlug ? `/projects/${entry.data.prevSlug}/` : "#"}
           class:list={["w-full font-semibold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.prevSlug}]}>
            {entry.data.prevSlug ? <div class="btn-card group rounded-2xl w-full h-[3.75rem] max-w-full px-5 flex items-center !justify-start gap-2" >
                <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-[var(--primary)] transition-all duration-300 ease-out group-hover:-translate-x-1.5" />
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75 group-hover:text-[var(--primary)]">
                    {entry.data.prevTitle}
                </div>
            </div> : <div class="btn-card rounded-2xl w-full h-[3.75rem] px-10 flex items-center justify-start text-black/50 dark:text-white/50 italic cursor-not-allowed font-normal">
                <div class="overflow-hidden overflow-ellipsis whitespace-nowrap pr-2">첫 번째 프로젝트입니다.</div>
            </div>}
        </a>

        <a href={entry.data.nextSlug ? `/projects/${entry.data.nextSlug}/` : "#"}
           class:list={["w-full font-semibold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.nextSlug}]}>
            {entry.data.nextSlug ? <div class="btn-card group rounded-2xl w-full h-[3.75rem] max-w-full px-5 flex items-center !justify-end gap-2">
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75 group-hover:text-[var(--primary)]">
                    {entry.data.nextTitle}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-[var(--primary)] transition-all duration-300 ease-out group-hover:translate-x-1.5" />
            </div> : <div class="btn-card rounded-2xl w-full h-[3.75rem] px-10 flex items-center justify-end gap-2 text-black/50 dark:text-white/50 italic cursor-not-allowed font-normal">
                <div class="overflow-hidden overflow-ellipsis whitespace-nowrap pr-2">마지막 프로젝트입니다.</div>
            </div>}
        </a>
    </div>

    <div class="card-base p-6 mb-4 min-h-[413px] md:min-h-[452px]">
        <Comment />
    </div>

</MainGridLayout>

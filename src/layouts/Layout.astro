---
import { profileConfig, siteConfig } from "@/config";
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/600.css";
import ConfigCarrier from "@components/ConfigCarrier.astro";
import ScrollProgress from "@components/control/ScrollProgress.astro";
import { SEO } from "astro-seo";
import "overlayscrollbars/overlayscrollbars.css";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import "../styles/main.css";
import type { Favicon } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
}

let { title, banner, description, lang, setOGTypeArticle } = Astro.props;

const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

const configHue = siteConfig.themeColor.hue;
if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = siteConfig.banner.src;
}

banner = siteConfig.banner.src;

const enableBanner = siteConfig.banner.enable;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] transition-colors duration-200 text-[16px] md:text-[16px] overflow-x-hidden"
>
	<head>
		<SEO
			title={pageTitle}
			description={description || pageTitle}
			canonical={Astro.url.href}
			openGraph={{
				basic: {
					title: pageTitle,
					type: setOGTypeArticle ? 'article' : 'website',
					image: banner.startsWith("/") ? new URL(banner, Astro.url).href : banner,
					url: Astro.url.href,
				},
				optional: {
					siteName: siteConfig.title,
					description: description || pageTitle,
				}
			}}
			twitter={{
				card: 'summary_large_image',
				title: pageTitle,
				description: description || pageTitle,
				image: banner.startsWith("/") ? new URL(banner, Astro.url).href : banner,
			}}
			extend={{
				meta: [
					{ name: 'author', content: profileConfig.name },
					{ name: 'viewport', content: 'width=device-width, initial-scale=1.0' },
					{ name: 'generator', content: Astro.generator },
					{ name: 'naver-site-verification', content: '74995f86fc463a9a7b1f0d2f669c8c76a2184cbd' },
					{ name: 'google-adsense-account', content: 'ca-pub-3632254045012910' },
				],
			}}
		/>

		<meta charset="UTF-8" />
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
		<link rel="stylesheet" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard-subset.css" />
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH, configHue}}>
			const theme = localStorage.getItem('theme') || DEFAULT_THEME;
			switch (theme) {
				case LIGHT_MODE:
					document.documentElement.classList.remove('dark');
					break
				case DARK_MODE:
					document.documentElement.classList.add('dark');
					break
				case AUTO_MODE:
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
			}

			let hue = localStorage.getItem('hue') || configHue;
            if (hue == '36') {
                hue = '250';
                localStorage.setItem('hue', '250');
            }
			document.documentElement.style.setProperty('--hue', hue);
		</script>
		<style define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`,
			'banner-height-extend': `${BANNER_HEIGHT_EXTEND}vh`,
		}}></style>

		<!-- Google AdSense (Lazy Load) -->
		<script is:inline>
			function loadAdSense() {
				if (window.adSenseLoaded) return;
				window.adSenseLoaded = true;
				const script = document.createElement('script');
				script.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3632254045012910";
				script.crossOrigin = "anonymous";
				script.async = true;
				document.head.appendChild(script);
			}

			const events = ['mousemove', 'scroll', 'touchstart', 'keydown'];
			function triggerAdSense() {
				loadAdSense();
				events.forEach(e => window.removeEventListener(e, triggerAdSense));
			}

			events.forEach(e => window.addEventListener(e, triggerAdSense, { passive: true }));
			setTimeout(loadAdSense, 3000);
		</script>

		<slot name="head"></slot>

		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>

	</head>
	<body class=" min-h-screen " class:list={[{"lg:is-home": isHomePage, "enable-banner": enableBanner}]}
	>
		<ScrollProgress />
		<ConfigCarrier></ConfigCarrier>
		<slot />

		<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
		<div id="page-height-extend" class="hidden h-0 overflow-hidden pointer-events-none"></div>
	</body>
</html>

<style is:global define:vars={{
	bannerOffset,
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
}}>
	/* 레이아웃 시프트 방지 핵심 */
	html {
		scrollbar-gutter: stable;
	}
	/* 브라우저 기본 스크롤바 숨기기 */
	html, body {
		scrollbar-width: none !important;
		-ms-overflow-style: none !important;
	}
	html::-webkit-scrollbar, body::-webkit-scrollbar {
		display: none !important;
	}

	#post-list-container {
		transition: opacity 120ms ease;
	}

    /* PhotoSwipe 돋보기 커서를 손가락 커서로 변경 */
    .custom-md img, #post-cover img {
        cursor: pointer !important;
    }
</style>

<script>
import { init, initContentEnhancements, setupClickOutside, setupScrollNavbar, initPhotoSwipe } from "../utils/init-utils";
import { BANNER_HEIGHT } from "../constants/constants";

const bannerEnabled = !!document.getElementById('banner-wrapper');

// 초기 로딩
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
        init();
        setupClickOutside();
        setupScrollNavbar(bannerEnabled, BANNER_HEIGHT);
    });
} else {
    init();
    setupClickOutside();
    setupScrollNavbar(bannerEnabled, BANNER_HEIGHT);
}

document.addEventListener('astro:page-load', initContentEnhancements);

// Swup 이벤트 연결
document.addEventListener('swup:enable', () => {
    const swup = (window as any).swup;
    if (!swup) return;
    swup.hooks.on('page:view', init);
});

// PhotoSwipe 초기화 (포스트 페이지에서만 실행)
if (window.location.pathname.includes('/posts/')) {
    initPhotoSwipe();
}
</script>

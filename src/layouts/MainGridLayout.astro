---
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import Search from "@components/Search.svelte";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import { pathsEqual, url } from "../utils/url-utils";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
} = Astro.props;
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "calc(72px + 1rem)";

const mainPanelTopMobile = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "calc(72px + 0.5rem)";
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>

{/* 글로벌 검색 패널 (전체 화면 오버레이 지원) */}
<Search client:load transition:persist />

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="z-50 pointer-events-none relative w-full max-w-[var(--page-width)] px-0 md:px-4 mx-auto">
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 w-full">
        <Navbar></Navbar>
    </div>
</div>

<!-- Banner -->
{siteConfig.banner.enable && <div id="banner-wrapper" class={`absolute z-10 w-full transition duration-700 overflow-hidden`} style={`top: -${BANNER_HEIGHT_EXTEND}vh`}>
    <ImageWrapper id="banner" alt="Banner of the blog" class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
                  src={siteConfig.banner.src} position={siteConfig.banner.position} loading="eager" fetchPriority="high"
    >
    </ImageWrapper>
</div>}

<!-- Main content grid -->
<div
    class:list={["w-full z-30 pointer-events-none", isHomePage ? "relative" : "absolute"]}
    style={isHomePage ? "margin-top: 1rem;" : `top: ${mainPanelTopMobile}; --main-panel-top: ${mainPanelTop};`}
>
    <style is:inline>
        @media (min-width: 768px) {
            div[style*="--main-panel-top"] {
                top: var(--main-panel-top) !important;
            }
        }

        .home-main-grid-flow {
            transform: none !important;
        }
    </style>
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
        <div id="main-grid" class:list={["w-full grid grid-cols-1 lg:grid-cols-[1fr_18.75rem] gap-2 md:gap-4 px-0 md:px-4", { "home-main-grid-flow": isHomePage }]}>
            
            {/* 1. 본문 영역 (Left Column) */}
            <div class="flex flex-col gap-2 md:gap-4">
                <main id="main-content" class="transition-swup-fade overflow-hidden flex flex-col">
                    <div id="content-wrapper" class="onload-animation grow">
                        <slot></slot>
                    </div>
                </main>
                <div id="footer-wrapper" class="transition-swup-fade mt-[14px] md:mt-[28px] mb-[22px] md:mb-[44px]">
                    <div class="onload-animation">
                        <Footer></Footer>
                    </div>
                </div>
            </div>

            {/* 2. 사이드바 영역 (Right Column) */}
            <aside class="hidden lg:flex lg:flex-col lg:gap-4">
                {/* 카테고리 (고정) */}
                <SideBar headings={headings} onlyCategories={true}></SideBar>
                
                {/* 광고 영역 (새로고침 대상) */}
                <div id="sidebar-ad" class="sticky top-4">
                    <SideBar headings={headings} onlyAd={true}></SideBar>
                </div>
            </aside>

            {/* Banner image credit */}
            {hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
                                   class:list={["group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                                   "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
            >
                <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa6-solid:arrow-up-right-from-square">
                </Icon>
            </a>}
        </div>
    </div>
</div>

<!-- TOC -->
{siteConfig.toc.enable && (
    <div class="absolute w-full z-0 hidden 2xl:block h-0 overflow-visible">
        <div class="relative max-w-[var(--page-width)] mx-auto">
            <div id="toc-wrapper" class:list={["hidden 2xl:block onload-animation transition-swup-fade transition-opacity duration-500 ease-out absolute top-0 pointer-events-auto"]}>
                <div class="fixed top-4 flex flex-col items-end w-fit"
                     style="right: calc(50vw + var(--page-width) / 2); max-width: calc(50vw - var(--page-width) / 2 - 16px);">
                    <div id="toc" class="w-full h-full flex flex-col items-end">
                        <TOC headings={headings} class="w-full max-w-[var(--toc-width)] ml-auto" isFloating={true}></TOC>
                    </div>
                </div>
            </div>
        </div>
    </div>
)}
</Layout>

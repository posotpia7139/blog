---
<div id="scroll-progress-container" class="fixed top-0 left-0 w-full h-[3px] z-[100] pointer-events-none opacity-0 transition-opacity duration-300">
    <div id="scroll-progress-bar" class="h-full bg-[var(--primary)] w-0 transition-all duration-150 ease-out shadow-[0_0_10px_var(--primary)]"></div>
</div>

<script>
    const container = document.getElementById('scroll-progress-container');
    const progressBar = document.getElementById('scroll-progress-bar');
    
    function updateProgress() {
        if (!progressBar || !container) return;

        const postContainer = document.getElementById('post-container');
        
        if (!postContainer) {
            container.classList.add('opacity-0');
            return;
        }

        container.classList.remove('opacity-0');

        const winScroll = window.scrollY || document.documentElement.scrollTop;
        const containerTop = postContainer.offsetTop;
        const containerHeight = postContainer.offsetHeight;
        const viewHeight = window.innerHeight;

        let scrolled = 0;
        if (winScroll < containerTop) {
            scrolled = 0;
        } else {
            const totalScrollable = containerHeight - viewHeight;
            if (totalScrollable > 0) {
                scrolled = ((winScroll - containerTop) / totalScrollable) * 100;
            } else {
                scrolled = 100;
            }
        }
        
        progressBar.style.width = Math.min(Math.max(scrolled, 0), 100) + "%";
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();

    document.addEventListener('swup:content:replace', updateProgress);
    document.addEventListener('astro:after-swap', updateProgress);
</script>

---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
---
<div class="card-base p-3">
    <a href={url('/about/')} class="flex items-center gap-4 mb-3 group"> <!-- This is now the link -->
        <div
           class="block shrink-0 w-[4.5rem] h-[4.5rem] overflow-hidden rounded-xl active:scale-95"> <!-- This is now a div -->
            <ImageWrapper src={config.avatar || ""} alt="Profile Image of the Author" class="w-full h-full object-cover" widths={[120, 240]} sizes="120px"></ImageWrapper>
        </div>
        <div class="flex-grow"> <!-- Container for name and bio, allowing it to grow -->
            <div class="font-semibold text-xl text-left dark:text-neutral-50 transition group-hover:text-[var(--primary)]">{config.name}</div>
            <!-- Blue line removed -->
            <div class="text-left text-neutral-400 transition">{config.bio}</div>
        </div>
    </a>
    <div class="px-2"> <!-- Links section, now outside the flex container -->
        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {config.links.length > 1 && config.links.map(item =>
                    <a rel="me" aria-label={item.name} href={item.url} target="_blank" class="btn-regular rounded-lg h-10 w-10 active:scale-90">
                        <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                    </a>
            )}
            {config.links.length == 1 && <a rel="me" aria-label={config.links[0].name} href={config.links[0].url} target="_blank"
                                            class="btn-regular rounded-lg h-10 gap-2 px-3 font-semibold active:scale-95">
                <Icon name={config.links[0].icon} class="text-[1.5rem]"></Icon>
                {config.links[0].name}
            </a>}
        </div>
    </div>
</div>


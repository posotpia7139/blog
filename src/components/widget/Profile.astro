---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
---
<div class="card-base p-4 flex flex-col items-center text-center">
    <div class="flex flex-col items-center gap-3 mb-3 w-full"> <!-- Gap reduced to 3 -->
        <div
           class="block shrink-0 w-[5rem] h-[5rem] overflow-hidden rounded-xl"> <!-- Size reduced to 5rem -->
            <ImageWrapper src={config.avatar || ""} alt="Profile of the Author" class="w-full h-full object-cover" widths={[80, 160]} sizes="80px" loading="eager" fetchPriority="high"></ImageWrapper>
        </div>
        <div class="w-full"> 
            <div class="font-bold text-lg dark:text-neutral-50 transition">{config.name}</div>
            <div class="text-neutral-400 text-sm transition mt-1">{config.bio}</div>
        </div>
    </div>
    <div class="px-2"> <!-- Links section, now outside the flex container -->
        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {config.links.length > 1 && config.links.map(item =>
                    <a rel="me" aria-label={item.name} href={item.url} target="_blank" class="btn-regular rounded-lg h-10 w-10 active:scale-90">
                        <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                    </a>
            )}
            {config.links.length == 1 && <a rel="me" aria-label={config.links[0].name} href={config.links[0].url} target="_blank"
                                            class="btn-regular rounded-lg h-10 gap-2 px-3 font-semibold active:scale-95">
                <Icon name={config.links[0].icon} class="text-[1.5rem]"></Icon>
                {config.links[0].name}
            </a>}
        </div>
    </div>
</div>
---
import { Icon } from "astro-icon/components";
import { getCategoryList, getSortedPosts } from "../../utils/content-utils";
import ButtonLink from "../control/ButtonLink.astro";
import WidgetLayout from "./WidgetLayout.astro";

const categories = await getCategoryList();
const allPosts = await getSortedPosts();

// [서버 사이드] 초기 로드 감지
const url = new URL(Astro.request.url);
let activeCategory = url.searchParams.get("category");
const isPostPage = !!Astro.params.slug; // 포스트 본문 여부 확인

if (!activeCategory && Astro.params.slug) {
	const currentPost = allPosts.find((p) => p.slug === Astro.params.slug);
	if (currentPost && currentPost.data.category) {
		activeCategory = currentPost.data.category;
	}
}

interface CategoryNode {
	name: string;
	fullPath: string;
	count: number;
	url: string;
	children: CategoryNode[];
}

function buildTree(flatCategories: any[]): CategoryNode[] {
	const root: CategoryNode[] = [];
	const map: { [key: string]: CategoryNode } = {};

	flatCategories.forEach((c) => {
		const node: CategoryNode = {
			name: c.name.split("/").pop() || "",
			fullPath: c.name,
			count: c.count,
			url: c.url,
			children: [],
		};
		map[c.name] = node;

		const parentPath = c.name.substring(0, c.name.lastIndexOf("/"));
		if (parentPath && map[parentPath]) {
			map[parentPath].children.push(node);
		} else {
			root.push(node);
		}
	});

	const sortNodes = (nodes: CategoryNode[]) => {
		nodes.sort((a, b) => {
			const aHasChildren = a.children.length > 0;
			const bHasChildren = b.children.length > 0;
			if (aHasChildren && !bHasChildren) return -1;
			if (!aHasChildren && bHasChildren) return 1;
			return 0;
		});
		nodes.forEach((node) => {
			if (node.children.length > 0) sortNodes(node.children);
		});
	};

	sortNodes(root);
	return root;
}

const categoryTree = buildTree(categories);

function isPathActive(nodePath: string, active: string | null) {
	if (!active) return false;
	return active === nodePath || active.startsWith(nodePath + "/");
}

interface Props {
	class?: string;
	style?: string;
}
const { class: className, style } = Astro.props;
---

<WidgetLayout name={""} id="categories" isCollapsed={false}
                class={className} style={style}
                data-id="categories"
>
    <div class="category-tree">
        <ul class="root-list">
            {categoryTree.map((node) => {
                const isActive = activeCategory === node.fullPath;
                const isPath = isPathActive(node.fullPath, activeCategory);
                
                return (
                    <li class="category-item root-item" data-path={node.fullPath}>
                        <ButtonLink
                            url={node.url}
                            label={`View all posts in the ${node.fullPath} category`}
                            class:list={["category-link", { "active-category-link": isActive, "reading-active-dot": isActive && isPostPage }]}
                        >
                            <span class="category-text-label">{node.name}</span>
                        </ButtonLink>
                        
                                                                                        {node.children.length > 0 && (
                        
                                                                                    <ul class="sub-list">
                        
                                                                                        {node.children.map((child) => {
                        
                                                                                            const isChildActive = activeCategory === child.fullPath;
                        
                                                                                            const isChildPath = isPathActive(child.fullPath, activeCategory);
                        
                                                                                            
                        
                                                                                            return (
                        
                                                                                                <li class="category-item accordion-item" data-path={child.fullPath}>
                        
                                                                                                    <div class="flex items-center group relative cursor-pointer rounded-lg overflow-hidden">
                        
                                                                                                        <ButtonLink
                        
                                                                                                            url={child.url}
                        
                                                                                                            label={`View all posts in the ${child.fullPath} category`}
                        
                                                                                                            class:list={["flex-grow category-link", { "active-category-link": isChildActive, "reading-active-dot": isChildActive && isPostPage }]}
                        
                                                                                                        >
                        
                                                                                                            <span class="category-text-label">{child.name}</span>
                        
                                                                                                        </ButtonLink>
                        
                                                                                                        {child.children.length > 0 && (
                        
                                                                                                            <div class="toggle-icon-wrapper absolute right-2 top-1/2 -translate-y-1/2 flex items-center justify-center w-8 h-8 pointer-events-none">
                        
                                                                                                                <Icon name="material-symbols:chevron-right-rounded" 
                        
                                                                                                                      class:list={["toggle-chevron text-2xl transition-all duration-500", { "active": isChildPath }]} 
                        
                                                                                                                      style={isChildPath ? "transform: rotate(90deg)" : ""}
                        
                                                                                                                />
                        
                                                                                                            </div>
                        
                                                                                                        )}
                        
                                                                                                    </div>
                        
                                                        
                        
                                                                                                    {child.children.length > 0 && (
                        
                                                                                                        <div class:list={["accordion-content overflow-hidden", { "open": isChildPath }]}
                        
                                                                                                             style={isChildPath ? "max-height: none" : "max-height: 0px"}
                        
                                                                                                        >
                        
                                                                                                            <ul class="grandchild-list">
                        
                                                                                                                {child.children.map((grandChild) => {
                        
                                                                                                                    const isGrandActive = activeCategory === grandChild.fullPath;
                        
                                                                                                                    return (
                        
                                                                                                                        <li class="category-item grandchild-item" data-path={grandChild.fullPath}>
                        
                                                                                                                            <ButtonLink
                        
                                                                                                                                url={grandChild.url}
                        
                                                                                                                                label={`View all posts in the ${grandChild.fullPath} category`}
                        
                                                                                                                                class:list={["category-link", { "active-category-link": isGrandActive, "reading-active-dot": isGrandActive && isPostPage }]}
                        
                                                                                                                            >
                        
                                                                                                                                <span class="category-text-label">{grandChild.name}</span>
                        
                                                                                                                            </ButtonLink>
                        
                                                                                                                        </li>
                        
                                                                                                                    );
                        
                                                                                                                })}
                        
                                                                                                            </ul>
                        
                                                                                                        </div>
                        
                                                                                                    )}
                        
                                                                                                </li>
                        
                                                                                            );
                        
                                                                                        })}
                        
                                                                                    </ul>
                        
                                                                                )}
                        
                                                        
                        
                        
                    </li>
                );
            })}
        </ul>
    </div>
</WidgetLayout>

<script>
    function setupAccordion() {
        const tree = document.querySelector('.category-tree') as HTMLElement;
        if (!tree) return;

        // [방어] 이미 초기화되었다면 더 이상 리스너를 추가하지 않음
        if (tree.dataset.initialized === 'true') {
            // 위치 표시 클래스만 업데이트하고 종료
            updateActiveStates(tree);
            return;
        }

        // 이벤트 위임: 트리 전체에 단 한 번만 등록
        tree.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            const accordionItem = target.closest('.accordion-item');
            if (!accordionItem) return;

            const content = accordionItem.querySelector('.accordion-content') as HTMLElement;
            const icon = accordionItem.querySelector('.toggle-chevron') as HTMLElement;
            
            const isTextClick = target.classList.contains('category-text-label') || target.closest('.category-text-label');

            if (content && icon) {
                // [공통 로직] 아코디언 토글 함수
                const performToggle = (forceState: boolean | null = null) => {
                    const willOpen = forceState !== null ? forceState : !content.classList.contains('open');
                    
                    if (willOpen) {
                        // 다른 항목 닫기
                        const allOpen = tree.querySelectorAll('.accordion-content.open');
                        allOpen.forEach(el => {
                            if (el !== content) {
                                (el as HTMLElement).style.maxHeight = '0px';
                                el.classList.remove('open');
                                const otherIcon = el.parentElement?.querySelector('.toggle-chevron') as HTMLElement;
                                if (otherIcon) {
                                    otherIcon.style.transform = 'rotate(0deg)';
                                    otherIcon.classList.remove('active');
                                }
                            }
                        });

                        content.style.maxHeight = content.scrollHeight + 'px';
                        content.classList.add('open');
                        icon.style.transform = 'rotate(90deg)';
                        icon.classList.add('active');
                    } else {
                        content.style.maxHeight = '0px';
                        content.classList.remove('open');
                        icon.style.transform = 'rotate(0deg)';
                        icon.classList.remove('active');
                    }
                };

                if (!isTextClick) {
                    // 1. 텍스트 외 클릭: 페이지 이동 방지 + 토글
                    e.preventDefault();
                    e.stopPropagation();
                    performToggle();
                } else {
                    // 2. 텍스트 클릭: 페이지 이동 허용 + 강제 펼치기
                    // 링크 이동 직전에 시각적으로 먼저 펼쳐줌
                    performToggle(true);
                }
            }
        });

        // 초기 로드 시 한 번만 실행
        updateActiveStates(tree, true);
        tree.dataset.initialized = 'true';
    }

    function updateActiveStates(tree: HTMLElement, firstLoad = false) {
        // 이전 표시 제거
        tree.querySelectorAll('.active-category-link, .reading-active-dot, .active-branch').forEach(el => {
            el.classList.remove('active-category-link', 'reading-active-dot', 'active-branch');
        });

        const urlParams = new URLSearchParams(window.location.search);
        const pathname = window.location.pathname;
        let activeCategory = urlParams.get('category');
        const isPostPage = pathname.includes('/posts/');

        if (!activeCategory && isPostPage) {
            const postMetaLink = document.querySelector('#post-container a[href*="category="]');
            if (postMetaLink) {
                const search = new URL((postMetaLink as HTMLAnchorElement).href, window.location.origin).search;
                activeCategory = new URLSearchParams(search).get('category');
            }
        }

        if (isPostPage) {
            tree.classList.add('is-reading');
        } else {
            tree.classList.remove('is-reading');
        }

        if (activeCategory) {
            const targetItems = document.querySelectorAll(`[data-path="${activeCategory}"]`);
            targetItems.forEach(item => {
                item.classList.add('active-branch');
                const btn = item.querySelector('.category-link');
                if (btn) {
                    btn.classList.add('active-category-link');
                    if (isPostPage) btn.classList.add('reading-active-dot');
                }
                
                let parent = item.closest('.accordion-item');
                while (parent) {
                    parent.classList.add('active-branch');
                    const content = parent.querySelector('.accordion-content') as HTMLElement;
                    const icon = parent.querySelector('.toggle-chevron') as HTMLElement;
                    if (content && firstLoad) { // [핵심] 첫 로드시에만 자동으로 펼침
                        if (!content.classList.contains('open')) {
                            content.style.maxHeight = content.scrollHeight + 'px';
                            content.classList.add('open');
                            if (icon) {
                                icon.style.transform = 'rotate(90deg)';
                                icon.classList.add('active');
                            }
                        }
                    }
                    parent = parent.parentElement?.closest('.accordion-item') || null;
                }
            });
        }
    }

    setupAccordion();
    document.addEventListener('astro:page-load', setupAccordion);
</script>

<style>
    .category-tree {
        contain: content; /* [최적화] 렌더링 범위 격리 */
    }
    .category-tree ul { list-style: none; padding: 0; margin: 0; }
    .category-item { margin-bottom: 0.25rem; position: relative; }
    .root-list > .category-item { margin-bottom: 1.5rem; }
    .root-list > .category-item:last-child { margin-bottom: 0; }
    .sub-list, .grandchild-list { margin-left: 1.5rem; padding-left: 0 !important; }
    .root-list > .category-item { padding-left: 0; }
    .sub-list > .category-item { padding-left: 1.5rem; }
    .grandchild-list .category-item { padding-left: 1.5rem; }

    .root-list > .category-item > :global(a) { font-weight: 600; }
    .sub-list > .category-item > div > :global(a), 
    .sub-list > .category-item > :global(a) { font-weight: 400; }
    .grandchild-list > .category-item > :global(a) { font-weight: 300; }

    /* 활성화 카테고리 (글자색 강조) */
    :global(button.active-category-link) {
        color: var(--primary) !important;
        font-weight: 600 !important;
        background-color: oklch(var(--primary) / 0.1) !important;
    }

    /* 독서 모드 전용 '불꽃 별표(*)' 포인트 (선명하게 표시) */
    :global(button.reading-active-dot .category-text-label::after) {
        content: "*";
        display: inline-block;
        color: var(--primary);
        font-weight: 800;
        font-size: 1.5rem;
        margin-left: 4px;
        vertical-align: middle;
        transform: translateY(-2px);
        line-height: 0;
    }

    .accordion-content { 
        transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1); 
        will-change: max-height; 
        overflow: hidden;
    }
    .toggle-chevron { 
        color: black; 
        opacity: 0.3; 
        will-change: transform; /* [최적화] 하드웨어 가속 */
    }
    :global(.dark) .toggle-chevron { color: white; opacity: 0.45; }
    .toggle-chevron.active { color: var(--primary) !important; opacity: 1 !important; }
    .group:hover .toggle-chevron { color: var(--primary); opacity: 0.6; }
    .category-tree :global(button) { height: 2.25rem !important; }
</style>

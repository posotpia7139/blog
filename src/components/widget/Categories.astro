---
import { Icon } from "astro-icon/components";
import {
	type Category,
	getCategoryList,
	getSortedPosts,
} from "../../utils/content-utils";
import { getCategoryUrl } from "../../utils/url-utils";
import WidgetLayout from "./WidgetLayout.astro";

const categories = await getCategoryList();
const allPosts = await getSortedPosts();

// [서버 사이드] 초기 로드 감지
const url = new URL(Astro.request.url);
let activeCategory = url.searchParams.get("category");
const isPostPage = !!Astro.params.slug;

if (!activeCategory && Astro.params.slug) {
	const currentPost = allPosts.find((p) => p.slug === Astro.params.slug);
	if (currentPost?.data.category) {
		activeCategory = currentPost.data.category;
	}
}

interface Props {
	class?: string;
	style?: string;
}
const { class: className, style } = Astro.props;
---

<WidgetLayout name={""} id="categories" isCollapsed={false}
                class={className} style={style}
                data-id="categories"
>
    <div class="category-tree">
        {/* 헤더 디자인 (모바일 메뉴와 통일) */}
        <div class="px-4 py-2 mb-2 flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.2em] text-black/60 dark:text-white/60 select-none"
             style="font-feature-settings: 'case' 1, 'cpsp' 1; font-kerning: normal;">
            <Icon name="material-symbols:folder-open-outline-rounded" class="text-base text-[var(--primary)] opacity-100 -translate-y-[0.5px]" />
            <span class="leading-none">Categories</span>
        </div>

        <ul class="root-list flex flex-col pb-2">
            {categories.map((cat) => {
                const isActive = activeCategory === cat.name;
                const isReading = isPostPage && activeCategory === cat.name;
                const parts = cat.name.split('/');
                const depth = parts.length; // 1, 2, 3
                
                return (
                    <li class="category-item mb-0.5" data-path={cat.name}>
                        <a href={getCategoryUrl(cat.name)} 
                           class:list={[
                                "group flex justify-between items-center py-2.5 pr-2 rounded-xl transition-all duration-300",
                                (isActive || isReading) ? "bg-[var(--primary)]/[0.08]" : "hover:bg-[var(--btn-plain-bg-hover)]",
                                depth === 1 ? "pl-4" : depth === 2 ? "pl-9" : "pl-14",
                                { "reading-active-star": isReading }
                           ]}
                        >
                            <div class:list={[
                                "text-sm transition-colors duration-300 flex items-center",
                                (isActive || isReading) ? "text-[var(--primary)]" : "text-black/70 dark:text-white/70 group-hover:text-[var(--primary)]",
                                depth === 1 ? "font-bold text-[15px]" : "font-light text-[14px]"
                            ]}>
                                <span class="category-label capitalize leading-none">{parts[parts.length - 1]}</span>
                            </div>
                        </a>
                    </li>
                )
            })}
        </ul>
    </div>
</WidgetLayout>

<script>
    function updateActiveStates() {
        const tree = document.querySelector('.category-tree') as HTMLElement;
        if (!tree) return;

        const urlParams = new URLSearchParams(window.location.search);
        const pathname = window.location.pathname;
        const isPostPage = pathname.includes('/posts/');

        // 초기화: 모든 활성 클래스 제거
        tree.querySelectorAll('.category-item a').forEach(el => {
            el.classList.remove('bg-[var(--primary)]/[0.08]', 'reading-active-star');
            const label = el.querySelector('div');
            if (label) {
                label.classList.remove('text-[var(--primary)]');
                label.classList.add('text-black/70', 'dark:text-white/70');
            }
        });

        // 현재 카테고리 결정
        let activeCategory = urlParams.get('category');
        if (!activeCategory && isPostPage) {
            const postContainer = document.querySelector('#post-container') as HTMLElement;
            activeCategory = postContainer?.dataset.category || null;
        }

        if (activeCategory) {
            const targetItem = tree.querySelector(`[data-path="${activeCategory}"] a`);
            if (targetItem) {
                targetItem.classList.add('bg-[var(--primary)]/[0.08]');
                const label = targetItem.querySelector('div');
                if (label) {
                    label.classList.add('text-[var(--primary)]');
                    label.classList.remove('text-black/70', 'dark:text-white/70');
                }
                if (isPostPage) {
                    targetItem.classList.add('reading-active-star');
                }
            }
        }
    }

    updateActiveStates();
    document.addEventListener('astro:page-load', updateActiveStates);
    document.addEventListener('astro:after-swap', updateActiveStates);
    document.addEventListener('swup:content:replace', updateActiveStates);
</script>

<style>
    .category-tree {
        contain: content;
    }
    .category-tree ul { list-style: none; padding: 0; margin: 0; }
    
    /* 독서 모드 별표(*) 포인트 */
    :global(.reading-active-star .category-label) {
        position: relative;
    }
    :global(.reading-active-star .category-label::after) {
        content: "*";
        position: absolute;
        right: -15px;
        top: -4px;
        color: var(--primary);
        font-weight: 900;
        font-size: 1.25rem;
        line-height: 1;
        opacity: 0; /* 초기 상태: 투명 */
        animation: pulse-opacity 1.5s ease-in-out infinite;
        animation-delay: 0.5s; /* 0.5초 대기 후 시작 */
    }

    @keyframes pulse-opacity {
        0% { opacity: 0; }
        50% { opacity: 1; }
        100% { opacity: 0; }
    }

    .category-label {
        text-transform: capitalize;
        white-space: nowrap;
    }

    /* 행 높이 고정으로 높이 변화 방지 */
    .category-item a {
        height: 2.5rem;
    }
</style>
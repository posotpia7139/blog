---
import { Icon } from "astro-icon/components";
import { getCategoryList, getSortedPosts } from "../../utils/content-utils";
import { getCategoryUrl } from "../../utils/url-utils";
import WidgetLayout from "./WidgetLayout.astro";

const categories = await getCategoryList();
const allPosts = await getSortedPosts();

// [서버 사이드] 초기 로드 감지
const url = new URL(Astro.request.url);
let activeCategory = url.searchParams.get("category");
const isPostPage = !!Astro.params.slug;

if (!activeCategory && Astro.params.slug) {
	const currentPost = allPosts.find((p) => p.slug === Astro.params.slug);
	if (currentPost?.data.category) {
		activeCategory = currentPost.data.category;
	}
}

interface Props {
	class?: string;
	style?: string;
}
const { class: className, style } = Astro.props;
---

<WidgetLayout name={""} id="categories" isCollapsed={false}
                class={className} style={style}
                data-id="categories"
>
        <div class="category-tree">
            {/* 헤더 디자인 (모바일 메뉴와 통일) */}
            <div class="pr-4 pl-0 py-2 mb-2 flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.2em] text-black/60 dark:text-white/60 select-none"
                 style="font-feature-settings: 'case' 1, 'cpsp' 1; font-kerning: normal;">
                <Icon name="material-symbols:folder-open-outline-rounded" class="text-base text-[var(--primary)] opacity-100 -translate-y-[0.5px]" />
                <span class="leading-none">Categories</span>
            </div>
        <ul class="root-list flex flex-col pb-2">
            {categories.map((cat) => {
                const isActive = activeCategory === cat.name;
                const isReading = isPostPage && activeCategory === cat.name;
                const parts = cat.name.split('/');
                const depth = parts.length; // 1, 2, 3
                
                return (
                    <li class="category-item mb-0.5" data-path={cat.name}>
                        <a href={getCategoryUrl(cat.name)} 
                           class:list={[
                                "group flex justify-between items-center py-2.5 pr-2 rounded-xl transition-all duration-300",
                                (isActive || isReading) ? "bg-[var(--primary)]/[0.08]" : "hover:bg-[var(--btn-plain-bg-hover)]",
                                depth === 1 ? "pl-[26px]" : depth === 2 ? "pl-[46px]" : "pl-[66px]",
                                { "reading-active-star": isReading }
                           ]}
                        >
                            <div class:list={[
                                "text-sm transition-colors duration-300 flex items-center relative",
                                (isActive || isReading) ? "text-[var(--primary)]" : "text-black/70 dark:text-white/70 group-hover:text-[var(--primary)]",
                                depth === 1 ? "font-extrabold text-[15px]" : "font-normal text-[15px]"
                            ]}>
                                <span class="category-label capitalize leading-none">{parts[parts.length - 1]}</span>
                                {/* 독서 중임을 나타내는 별표 (*) - 실제 요소로 변경하여 페이드 아웃 지원 */}
                                <span class:list={["reading-star ml-1.5 font-black text-xl leading-none",
                                    { "is-reading": isReading }
                                ]}>*</span>
                            </div>
                        </a>
                    </li>
                )
            })}
        </ul>
    </div>
</WidgetLayout>

<script is:inline>
    // [핵심] 사이드바 전체 애니메이션 즉시 제어 (카테고리 + 광고 포함)
    (function() {
        if (window.sidebarLoaded) {
            const widgets = document.querySelectorAll('.sidebar-widget');
            widgets.forEach(widget => {
                widget.classList.remove('sidebar-onload-animation');
                widget.style.opacity = '1';
                widget.style.transform = 'none';
            });
        }
    })();
</script>

<script>
    // 전역 변수로 마지막으로 처리한 경로 저장 (중복 실행 방지)
    window.lastProcessedPath = window.lastProcessedPath || '';

    function updateActiveStates() {
        const pathname = window.location.pathname;
        const search = window.location.search;
        const currentFullHref = pathname + search;

        // [핵심 가드] 이미 처리된 URL이라면 로직 수행 안 함
        if (window.lastProcessedPath === currentFullHref) return;
        window.lastProcessedPath = currentFullHref;

        const tree = document.querySelector('.category-tree') as HTMLElement;
        if (!tree) {
            window.lastProcessedPath = ''; 
            return;
        }

        const urlParams = new URLSearchParams(search);
        const isPostPage = pathname.includes('/posts/');

        // 현재 카테고리 결정
        let activeCategory = urlParams.get('category');
        if (!activeCategory && isPostPage) {
            const postContainer = document.querySelector('#post-container') as HTMLElement;
            activeCategory = postContainer?.dataset.category || null;
        }

        // 1. DOM에서 현재 활성화된 항목과 새로 활성화될 항목 찾기
        const currentActiveA = tree.querySelector('.category-item a.bg-\\[var\\(--primary\\)\\]\\/\\[0\\.08\\]');
        const targetA = activeCategory ? tree.querySelector(`[data-path="${activeCategory}"] a`) : null;

        // 2. 변경이 필요 없는 경우 즉시 종료
        if (currentActiveA === targetA) {
            if (targetA) {
                const star = targetA.querySelector('.reading-star');
                if (star) {
                    star.classList.toggle('is-reading', isPostPage);
                }
            }
            return;
        }

        // 3. 수술적 업데이트 (Surgical Update)
        if (currentActiveA) {
            currentActiveA.classList.remove('bg-[var(--primary)]/[0.08]');
            const star = currentActiveA.querySelector('.reading-star');
            if (star) {
                star.classList.remove('is-reading');
            }
            const labelDiv = currentActiveA.querySelector('div');
            if (labelDiv) {
                labelDiv.classList.remove('text-[var(--primary)]');
                labelDiv.classList.add('text-black/70', 'dark:text-white/70');
            }
        }

        if (targetA) {
            targetA.classList.add('bg-[var(--primary)]/[0.08]');
            const star = targetA.querySelector('.reading-star');
            if (isPostPage && star) {
                star.classList.add('is-reading');
            }
            const labelDiv = targetA.querySelector('div');
            if (labelDiv) {
                labelDiv.classList.add('text-[var(--primary)]');
                labelDiv.classList.remove('text-black/70', 'dark:text-white/70');
            }
        }
    }

    // 초기 로드 및 전환 완료 시 실행 (astro:page-load 하나로 통합)
    document.addEventListener('astro:page-load', () => {
        updateActiveStates();
        
        // 사이드바 로드 상태 기록 (첫 애니메이션이 끝난 후)
        if (!window.sidebarLoaded) {
            setTimeout(() => { window.sidebarLoaded = true; }, 1000);
        }
    });
    
    // 초기 실행
    updateActiveStates();
</script>

<style>
    .category-tree {
        contain: content;
    }
    .category-tree ul { list-style: none; padding: 0; margin: 0; }
    
    /* 독서 모드 별표(*) 포인트 */
    .reading-star {
        color: var(--primary);
        transition: opacity 0.8s ease-in-out;
        will-change: opacity;
        opacity: 0;
        pointer-events: none;
    }

    /* 독서 중일 때 투명도만 조절 (애니메이션 제거) */
    .reading-star.is-reading {
        opacity: 1;
    }

    .category-label {
        text-transform: capitalize;
        white-space: nowrap;
    }

    /* 행 높이 고정으로 높이 변화 방지 */
    .category-item a {
        height: 2.5rem;
    }
</style>
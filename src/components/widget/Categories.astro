---
import { getCategoryList } from "../../utils/content-utils";
import ButtonLink from "../control/ButtonLink.astro";
import WidgetLayout from "./WidgetLayout.astro";
import { Icon } from "astro-icon/components";

const categories = await getCategoryList();

interface CategoryNode {
	name: string;
	fullPath: string;
	count: number;
	url: string;
	children: CategoryNode[];
}

function buildTree(flatCategories: any[]): CategoryNode[] {
	const root: CategoryNode[] = [];
	const map: { [key: string]: CategoryNode } = {};

	flatCategories.forEach((c) => {
		const node: CategoryNode = {
			name: c.name.split("/").pop() || "",
			fullPath: c.name,
			count: c.count,
			url: c.url,
			children: [],
		};
		map[c.name] = node;

		const parentPath = c.name.substring(0, c.name.lastIndexOf("/"));
		if (parentPath && map[parentPath]) {
			map[parentPath].children.push(node);
		} else {
			root.push(node);
		}
	});

	const sortNodes = (nodes: CategoryNode[]) => {
		nodes.sort((a, b) => {
			const aHasChildren = a.children.length > 0;
			const bHasChildren = b.children.length > 0;
			if (aHasChildren && !bHasChildren) return -1;
			if (!aHasChildren && bHasChildren) return 1;
			return 0;
		});
		nodes.forEach(node => {
			if (node.children.length > 0) sortNodes(node.children);
		});
	};

	sortNodes(root);
	return root;
}

const categoryTree = buildTree(categories);

interface Props {
	class?: string;
	style?: string;
}
const { class: className, style } = Astro.props;
---

<WidgetLayout name={""} id="categories" isCollapsed={false}
                class={className} style={style}
>
    <div class="category-tree">
        <ul class="root-list">
            {categoryTree.map((node) => (
                <li class="category-item">
                    <ButtonLink
                        url={node.url}
                        label={`View all posts in the ${node.fullPath} category`}
                        class={node.children.length === 0 ? "leaf-node" : ""}
                    >
                        {node.name}
                    </ButtonLink>
                    
                    {node.children.length > 0 && (
                        <ul class="sub-list">
                            {node.children.map((child) => (
                                <li class="category-item accordion-item" data-path={child.fullPath.replace(/\//g, '-')}>
                                    <div class="flex items-center group relative cursor-pointer">
                                        <ButtonLink
                                            url={child.url}
                                            label={`View all posts in the ${child.fullPath} category`}
                                            class={`flex-grow ${child.children.length === 0 ? "leaf-node" : ""}`}
                                        >
                                            {child.name}
                                        </ButtonLink>
                                        {child.children.length > 0 && (
                                            <div class="toggle-icon-wrapper absolute right-2 top-1/2 -translate-y-1/2 flex items-center justify-center w-8 h-8 pointer-events-none">
                                                <Icon name="material-symbols:chevron-right-rounded" class="toggle-chevron text-2xl text-black/20 dark:text-white/20 transition-all duration-500" />
                                            </div>
                                        )}
                                    </div>

                                    {child.children.length > 0 && (
                                        <div class="accordion-content overflow-hidden max-h-0">
                                            <ul class="grandchild-list">
                                                {child.children.map((grandChild) => (
                                                    <li class="category-item">
                                                        <ButtonLink
                                                            url={grandChild.url}
                                                            label={`View all posts in the ${grandChild.fullPath} category`}
                                                            class="leaf-node"
                                                        >
                                                            {grandChild.name}
                                                        </ButtonLink>
                                                    </li>
                                                ))}
                                            </ul>
                                        </div>
                                    )}
                                </li>
                            ))}
                        </ul>
                    )}
                </li>
            ))}
        </ul>
    </div>
</WidgetLayout>

<script>
    function setupAccordion() {
        const accordionItems = document.querySelectorAll('.accordion-item');
        
        accordionItems.forEach(item => {
            const header = item.querySelector('.group');
            const content = item.querySelector('.accordion-content') as HTMLElement;
            const icon = item.querySelector('.toggle-chevron') as HTMLElement;

            if (!content || !icon || !header) return;
            if (item.getAttribute('data-accordion-initialized') === 'true') return;

            header.addEventListener('click', (e) => {
                const isLinkClick = (e.target as HTMLElement).closest('a');
                
                if (!isLinkClick) {
                    e.preventDefault();
                    e.stopPropagation();

                    const isOpen = content.classList.contains('open');
                    if (isOpen) {
                        content.style.maxHeight = '0px';
                        content.classList.remove('open');
                        icon.style.transform = 'rotate(0deg)';
                        icon.classList.remove('active');
                    } else {
                        content.style.maxHeight = content.scrollHeight + 'px';
                        content.classList.add('open');
                        icon.style.transform = 'rotate(90deg)';
                        icon.classList.add('active');
                    }
                }
            });

            item.setAttribute('data-accordion-initialized', 'true');
        });
    }

    setupAccordion();
    document.addEventListener('astro:page-load', setupAccordion);
    document.addEventListener('astro:after-swap', setupAccordion);
</script>

<style>
    .category-tree ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .category-item {
        margin-bottom: 0.25rem;
        position: relative;
    }
    /* 1차 목록 사이 간격 확대 */
    .root-list > .category-item {
        margin-bottom: 0.75rem;
    }
    .root-list > .category-item:last-child {
        margin-bottom: 0;
    }

    .sub-list, .grandchild-list {
        margin-left: 1.5rem;
        padding-left: 0 !important;
        position: relative;
    }

    /* 1단계: 들여쓰기 없음 */
    .root-list > .category-item {
        padding-left: 0;
    }

    /* 2단계: 1.5rem 파고들기 */
    .sub-list > .category-item {
        padding-left: 1.5rem;
    }

    /* 3단계: 가지형 디자인 적용 */
    .grandchild-list .category-item {
        padding-left: 1.5rem;
        position: relative;
    }

    /* 3단계 공통 수직선 (│) */
    .grandchild-list .category-item::before {
        content: "";
        position: absolute;
        left: 0.5rem;
        top: -0.5rem;
        bottom: 0;
        border-left: 1.5px dashed oklch(0.6 0 var(--hue));
        opacity: 0.6;
    }

    /* 3단계 공통 수평선 (─) */
    .grandchild-list .category-item::after {
        content: "";
        position: absolute;
        left: 0.5rem;
        top: 1.125rem;
        width: 0.8rem;
        border-top: 1.5px dashed oklch(0.6 0 var(--hue));
        opacity: 0.6;
    }

    /* 마지막 항목의 수직선 꺾임 (└─) */
    .grandchild-list .category-item:last-child::before {
        bottom: auto;
        height: 1.625rem;
    }

    /* 위계별 굵기 (600 - 400 - 300) */
    .root-list > .category-item > :global(a) { font-weight: 600; }
    .sub-list > .category-item > div > :global(a), 
    .sub-list > .category-item > :global(a) { font-weight: 400; }
    .grandchild-list > .category-item > :global(a) { font-weight: 300; }

    /* 리프 노드 호버 효과 */
    :global(.leaf-node button) {
        @apply hover:bg-[oklch(var(--primary)/0.1)] dark:hover:bg-[oklch(var(--primary)/0.2)];
    }

    /* 아코디언 컨텐츠 애니메이션 */
    .accordion-content {
        transition: max-height 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* 아이콘 스타일 정제 */
    .toggle-icon-wrapper {
        pointer-events: auto; /* 호버 감지를 위해 활성화 */
        cursor: pointer;
    }

    .toggle-chevron {
        color: currentColor;
        opacity: 0.2;
    }

    .toggle-chevron.active {
        color: var(--primary) !important;
        opacity: 1 !important;
    }

    /* 1. 라인 전체 호버 시 화살표 존재감 살짝 노출 */
    .group:hover .toggle-chevron {
        color: var(--primary);
        opacity: 0.5;
    }

    /* 2. 화살표 영역에 직접 호버 시 강력한 하이라이트 */
    .toggle-icon-wrapper:hover .toggle-chevron {
        color: var(--primary) !important;
        opacity: 1 !important;
        filter: drop-shadow(0 0 4px oklch(var(--primary) / 0.3)); /* 은은한 광채 효과 추가 */
    }

    /* 3. 텍스트 링크 호버 시 화살표 강조 억제 */
    .group:has(a:hover) .toggle-chevron {
        opacity: 0.1 !important;
        color: currentColor !important;
    }
</style>

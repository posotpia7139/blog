---
import type { MarkdownHeading } from "astro";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import Tag from "./Tags.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Categories class="onload-animation" style="animation-delay: 150ms"></Categories>
    </div>
    <div id="sidebar-sticky" class="sticky transition-all duration-700 flex flex-col w-full gap-4 top-4">
        <!-- Ad Space: 기본적으로 숨김, 스크립트로 포스트 본문에서만 노출 -->
        <div id="sidebar-ad" class="hidden w-[300px] h-[600px] bg-gray-200 dark:bg-gray-800 items-center justify-center text-sm text-gray-500 rounded-lg overflow-hidden">
            Adsense (300x600)
        </div>

        <!-- <Tag class="onload-animation" style="animation-delay: 200ms"></Tag> -->
    </div>
</div>

<script>
    function updateAdVisibility() {
        const ad = document.getElementById('sidebar-ad');
        if (!ad) return;

        const pathname = window.location.pathname;
        // 포스트 본문 경로(/posts/...)인 경우에만 광고 노출
        const isPostPage = pathname.includes('/posts/');
        
        if (isPostPage) {
            ad.classList.remove('hidden');
            ad.classList.add('lg:flex'); // 데스크탑에서만 flex로 노출
        } else {
            ad.classList.add('hidden');
            ad.classList.remove('lg:flex');
        }
    }

    // 초기 로드 및 페이지 전환 시 실행
    updateAdVisibility();
    document.addEventListener('astro:page-load', updateAdVisibility);
</script>
---
import type { MarkdownHeading } from "astro";
import Categories from "./Categories.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
	onlyAd?: boolean;
	onlyCategories?: boolean;
}

const { class: className, onlyAd, onlyCategories } = Astro.props;
---
<div class:list={[className, "w-full"]}>
    {/* 카테고리 영역 */}
    {!onlyAd && (
        <div class="flex flex-col w-full gap-4">
            <Categories class="onload-animation" style="animation-delay: 100ms"></Categories>
        </div>
    )}
    
    {/* 광고 영역 */}
    {!onlyCategories && (
        <div class="sticky top-4 flex flex-col w-full gap-4">
            {/* 300x600 Ad */}
            <div class="flex onload-animation w-full h-[600px] bg-gray-200 dark:bg-gray-800 items-center justify-center text-sm text-gray-500 rounded-lg overflow-hidden" style="animation-delay: 100ms">
                SideBar Ad (300x600)
            </div>
            {/* 300x250 Ad */}
            <div class="flex onload-animation w-full h-[250px] bg-gray-200 dark:bg-gray-800 items-center justify-center text-sm text-gray-500 rounded-lg overflow-hidden" style="animation-delay: 150ms">
                SideBar Ad (300x250)
            </div>
        </div>
    )}
</div>
---
import type { MarkdownHeading } from "astro";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import Tag from "./Tags.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
    onlyAd?: boolean;
    onlyCategories?: boolean;
}

const { class: className, headings, onlyAd, onlyCategories } = Astro.props;
---
<div class:list={[className, "w-full"]}>
    {/* 카테고리 영역 */}
    {!onlyAd && (
        <div class="flex flex-col w-full gap-4">
            <Categories class="onload-animation" style="animation-delay: 100ms"></Categories>
        </div>
    )}
    
    {/* 광고 영역 */}
    {!onlyCategories && (
        <div class="sticky top-4 flex flex-col w-full gap-4">
            <div class="flex onload-animation w-full h-[600px] bg-gray-200 dark:bg-gray-800 items-center justify-center text-sm text-gray-500 rounded-lg overflow-hidden" style="animation-delay: 100ms">
                {/* 광고 콘텐츠 */}
                SideBar Ad
            </div>
        </div>
    )}
</div>
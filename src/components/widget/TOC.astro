---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import { url } from "../../utils/url-utils";

interface Props {
	class?: string;
	headings: MarkdownHeading[];
	isFloating?: boolean;
}

let { headings = [], isFloating = false } = Astro.props;

let minDepth = 10;
for (const heading of headings) {
	minDepth = Math.min(minDepth, heading.depth);
}

const className = Astro.props.class;
const isPostsRoute = Astro.url.pathname.startsWith(url("/posts/"));
const isProjectsRoute = Astro.url.pathname.startsWith(url("/projects/"));
const shouldShowTOC = isPostsRoute || isProjectsRoute;

const removeTailingHash = (text: string) => {
	let lastIndexOfHash = text.lastIndexOf("#");
	if (lastIndexOfHash !== text.length - 1) {
		return text;
	}

	return text.substring(0, lastIndexOfHash);
};

// [추가] 헤더 텍스트 앞의 자동 생성된 번호(1. 1.1. 등) 제거
const cleanHeadingText = (text: string) => {
	const textWithoutHash = removeTailingHash(text);
	return textWithoutHash.replace(/^(\d+\.)+\s*/, "");
};

let heading1Count = 1;

const maxLevel = siteConfig.toc.depth;

// [수정] Footnotes 및 관련 글 제목 제외 (필터링 강화)
const filteredHeadings = headings.filter((heading) => {
	const text = heading.text.toLowerCase().trim();
	const slug = heading.slug.toLowerCase();

	const isTooDeep = heading.depth >= minDepth + maxLevel;
	const isFootnote =
		slug.includes("footnote") ||
		slug.includes("각주") ||
		text.includes("footnote") ||
		text === "각주" ||
		text === "footnotes" ||
		heading.depth === 100;

	const isExcludedTitle =
		text.includes("related posts") || text.includes("관련 글");

	return !isTooDeep && !isFootnote && !isExcludedTitle;
});
---
{shouldShowTOC &&
<table-of-contents class:list={[className, "block relative text-left"]} data-is-floating={isFloating}>
    <div class:list={["w-full", {"toc-inner-wrapper hide-scrollbar flex flex-col pb-24": isFloating}]}>
        <div class="toc w-full h-full">
            {/* 초기 렌더링 (서버 사이드) */}
            {filteredHeadings.map((heading) =>
                <a href={`#${heading.slug}`} class:list={["group pr-3.5 pl-3.5 flex items-start gap-2 relative transition-all duration-100 ease-out w-full min-h-[26px] rounded-xl hover:bg-[var(--toc-btn-active)] active:bg-[var(--toc-btn-active)] py-0.5"
                ]}>
                    <div class:list={["transition w-5 h-5 shrink-0 rounded-lg text-xs flex items-center justify-center font-bold mt-0.5",
                        {
                            "bg-[var(--toc-badge-bg)] text-[var(--btn-content)]": heading.depth == minDepth,
                            "ml-4": heading.depth == minDepth + 1,
                        }
                    ]}
                    >
                        {heading.depth == minDepth && heading1Count++}
                        {heading.depth == minDepth + 1 && <div class="transition w-2 h-2 rounded-[0.1875rem] bg-[var(--toc-badge-bg)]"></div>}
                    </div>
                    <div class:list={["transition text-[14px] text-left truncate leading-snug py-0.5 group-hover:text-[oklch(0.20_0.14_var(--hue))] dark:group-hover:text-[var(--primary)] flex-1 min-w-0",
                        {"text-black/100 dark:text-white/90": !isFloating},
                        {"text-black/80 dark:text-white/90 [.visible_&]:text-black/100 [.visible_&]:dark:text-white/90": isFloating}
                    ]}>{cleanHeadingText(heading.text)}</div>
                </a>
            )}
            {isFloating && <div class="active-indicator -z-10 absolute bg-[var(--toc-btn-hover)] rounded-xl transition-all duration-100 ease-out pointer-events-none border-2 border-[var(--toc-btn-hover)] group-hover:border-[var(--toc-btn-active)] border-dashed box-border shadow-sm" style="opacity: 0"></div>}
        </div>
    </div>
</table-of-contents>}

<script>
class TableOfContents extends HTMLElement {
    tocEl: HTMLElement | null = null;
    visibleClass = "visible";
    observer: IntersectionObserver;
    anchorNavTarget: HTMLElement | null = null;
    headingIdxMap = new Map<string, number>();
    headings: HTMLElement[] = [];
    tocEntries: HTMLAnchorElement[] = [];
    active: boolean[] = [];
    activeIndicator: HTMLElement | null = null;
    lastScrollY = 0;
    isScrollingDown = true;

    constructor() {
        super();
        this.observer = new IntersectionObserver(
            () => { this.fallback(); this.update(); }, 
            { threshold: 0, rootMargin: "-15% 0px 0px 0px" }
        );
    };

    refresh = () => {
        // [수정] setTimeout 대신 requestAnimationFrame을 사용하여 렌더링 타이밍 최적화
        requestAnimationFrame(() => {
            const pathname = window.location.pathname;
            const search = window.location.search;
            const currentHref = pathname + search;

            // 이미 처리된 URL이고 항목이 존재한다면 스킵 (깜빡임 방지)
            if (this.dataset.processedHref === currentHref && this.querySelector('.toc a')) return;
            this.dataset.processedHref = currentHref;

            this.observer.disconnect();
            this.rebuildTOC();
            this.init();
        });
    };

    rebuildTOC = () => {
        const tocContainer = this.querySelector(".toc");
        if (!tocContainer) return;

        tocContainer.innerHTML = '';

        // 본문 영역만 정확히 타겟팅
        const contentArea = document.querySelector('.markdown-content') || document.querySelector('#post-container');
        if (!contentArea) {
            this.style.display = 'none';
            return;
        }

        const rawHeadings = Array.from(contentArea.querySelectorAll('h1, h2, h3')); 
        const validHeadings = rawHeadings.filter(h => {
            const id = h.id.toLowerCase();
            const text = h.textContent?.toLowerCase().trim() || '';
            const isFootnote = id.includes('footnote') || text.includes('각주') || text.includes('footnote');
            const isExcluded = text === 'related posts' || text === '관련 글';
            return id && !isFootnote && !isExcluded;
        });

        if (validHeadings.length === 0) {
            this.style.display = 'none';
            return;
        }

        this.style.display = 'block';
        let minDepth = Math.min(...validHeadings.map(h => parseInt(h.tagName.substring(1))));
        let h1Count = 1;

        validHeadings.forEach(h => {
            const depth = parseInt(h.tagName.substring(1));
            const text = h.textContent || '';
            const slug = h.id;
            
            const a = document.createElement('a');
            a.href = `#${slug}`;
            a.className = "group pr-3.5 pl-3.5 flex items-start gap-2 relative transition-all duration-100 ease-out w-full min-h-[26px] rounded-xl hover:bg-[var(--toc-btn-active)] active:bg-[var(--toc-btn-active)] py-0.5";
            
            let badgeHTML = '';
            if (depth === minDepth) {
                badgeHTML = `<div class="transition w-5 h-5 shrink-0 rounded-lg text-xs flex items-center justify-center font-bold mt-0.5 bg-[var(--toc-badge-bg)] text-[var(--btn-content)]">${h1Count++}</div>`;
            } else {
                // depth === minDepth + 1 이상은 모두 점 형태의 배지로 표시 (현재는 H3만 해당)
                badgeHTML = `<div class="transition w-5 h-5 shrink-0 flex items-center justify-center mt-0.5 ml-4"><div class="transition w-2 h-2 rounded-[0.1875rem] bg-[var(--toc-badge-bg)]"></div></div>`;
            }

            // 서버 사이드와 100% 동일한 클래스와 구조 유지
            a.innerHTML = `${badgeHTML}<div class="transition text-[14px] text-left truncate leading-snug py-0.5 text-black/80 dark:text-white/90 group-hover:text-[oklch(0.20_0.14_var(--hue))] dark:group-hover:text-[var(--primary)] flex-1 min-w-0">${text.replace(/^(\d+\.)+\s*/, "")}</div>`;
            tocContainer.appendChild(a);
        });

        if (this.dataset.isFloating === 'true') {
            const indicator = document.createElement('div');
            indicator.className = "active-indicator -z-10 absolute bg-[var(--toc-btn-hover)] rounded-xl transition-all duration-100 ease-out pointer-events-none border-2 border-[var(--toc-btn-hover)] group-hover:border-[var(--toc-btn-active)] border-dashed box-border shadow-sm";
            indicator.style.opacity = '0';
            tocContainer.appendChild(indicator);
        }
    };

    toggleActiveHeading = () => {
        if (this.dataset.isFloating !== 'true') return; // 플로팅일 때만 액티브 표시

        let activeIdx = -1;
        for (let i = 0; i < this.active.length; i++) {
            if (this.active[i]) activeIdx = i;
        }

        const scrollHeight = document.documentElement.scrollHeight;
        const scrollTop = window.scrollY;
        const clientHeight = document.documentElement.clientHeight;
        if (scrollTop + clientHeight >= scrollHeight - 100) {
            activeIdx = this.active.length - 1;
        }

        this.tocEntries.forEach(entry => entry.classList.remove(this.visibleClass));

        if (activeIdx !== -1 && this.tocEntries[activeIdx]) {
            const entry = this.tocEntries[activeIdx];
            entry.classList.add(this.visibleClass);
            const top = entry.offsetTop;
            const left = entry.offsetLeft;
            const width = entry.offsetWidth;
            const height = entry.offsetHeight;
            this.activeIndicator?.setAttribute("style", `top: ${top}px; left: ${left}px; width: ${width}px; height: ${height}px; opacity: 1`);
        } else {
            this.activeIndicator?.setAttribute("style", `opacity: 0`);
        }
    };

    scrollToActiveHeading = () => {
        if (this.anchorNavTarget || !this.tocEl || this.dataset.isFloating !== 'true') return;
        const activeHeading = this.querySelector<HTMLDivElement>(`.${this.visibleClass}`);
        if (!activeHeading) return;
        this.tocEl.scrollTo({ top: activeHeading.offsetTop - 32, left: 0, behavior: "smooth" });
    };

    update = () => { requestAnimationFrame(() => { this.toggleActiveHeading(); this.scrollToActiveHeading(); }); };

    fallback = () => {
        if (!this.headings.length) return;
        this.active.fill(false);

        const thresholdLine = this.isScrollingDown ? window.innerHeight * 0.2 : window.innerHeight * 0.15;
        let currentIdx = -1;
        for (let i = 0; i < this.headings.length; i++) {
            if (this.headings[i] && this.headings[i].getBoundingClientRect().top <= thresholdLine) currentIdx = i;
            else break;
        }
        if (currentIdx !== -1) this.active[currentIdx] = true;
    };

    handleAnchorClick = (event: Event) => {
        const anchor = event.composedPath().find((el) => el instanceof HTMLAnchorElement) as HTMLAnchorElement;
        if (anchor) {
            const id = decodeURIComponent(anchor.hash?.substring(1));
            const idx = this.headingIdxMap.get(id);
            this.anchorNavTarget = idx !== undefined ? this.headings[idx] : null;
        }
    };

    handleScroll = () => {
        const currentScrollY = window.scrollY;
        this.isScrollingDown = currentScrollY > this.lastScrollY;
        this.lastScrollY = currentScrollY;
        this.fallback();
        this.update();
    };

    connectedCallback() {
        this.init();
        window.addEventListener('scroll', this.handleScroll, { passive: true });
        document.addEventListener('astro:after-swap', this.refresh);
        document.addEventListener('astro:page-load', this.refresh);
    };

    clearTOC = () => {
        if (this.dataset.isFloating === 'true') {
            const tocContainer = this.querySelector(".toc");
            if (tocContainer) tocContainer.innerHTML = '';
            this.style.display = 'none';
        }
    };

    init() {
        this.observer.disconnect();
        this.headingIdxMap.clear();
        this.headings = [];
        this.active = [];
        this.tocEl = this.querySelector(".toc-inner-wrapper");
        
        // 클릭 이벤트 리스너 중복 방지를 위해 제거 후 등록
        this.tocEl?.removeEventListener("click", this.handleAnchorClick);
        this.tocEl?.addEventListener("click", this.handleAnchorClick, { capture: true });
        
        this.activeIndicator = this.querySelector(".active-indicator");
        this.tocEntries = Array.from(this.querySelectorAll<HTMLAnchorElement>(".toc a[href^='#']"));
        
        if (this.tocEntries.length === 0) {
            // 항목이 없으면 본문에서 다시 찾아보기 (클라이언트 사이드 네비게이션 대응)
            this.rebuildTOC();
            this.tocEntries = Array.from(this.querySelectorAll<HTMLAnchorElement>(".toc a[href^='#']"));
            if (this.tocEntries.length === 0) return;
        }

        this.headings = new Array(this.tocEntries.length);
        for (let i = 0; i < this.tocEntries.length; i++) {
            const id = decodeURIComponent(this.tocEntries[i].hash?.substring(1));
            const heading = document.getElementById(id);
            if (heading) {
                this.headings[i] = heading;
                this.headingIdxMap.set(id, i);
                this.observer.observe(heading);
            }
        }
        this.active = new Array(this.tocEntries.length).fill(false);
        this.fallback();
        this.update();
    };

    disconnectedCallback() {
        this.observer.disconnect();
        this.tocEl?.removeEventListener("click", this.handleAnchorClick);
        window.removeEventListener('scroll', this.handleScroll);
        document.removeEventListener('astro:after-swap', this.refresh);
        document.removeEventListener('astro:page-load', this.refresh);
    };
}

if (!customElements.get("table-of-contents")) {
    customElements.define("table-of-contents", TableOfContents);
}
</script>
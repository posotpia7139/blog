---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import { url } from "../../utils/url-utils";

interface Props {
	class?: string;
	headings: MarkdownHeading[];
	isFloating?: boolean;
}

let { headings = [], isFloating = false } = Astro.props;

let minDepth = 10;
for (const heading of headings) {
	minDepth = Math.min(minDepth, heading.depth);
}

const className = Astro.props.class;
const isPostsRoute = Astro.url.pathname.startsWith(url("/posts/"));
const isProjectsRoute = Astro.url.pathname.startsWith(url("/projects/"));
const shouldShowTOC = isPostsRoute || isProjectsRoute;

const removeTailingHash = (text: string) => {
	let lastIndexOfHash = text.lastIndexOf("#");
	if (lastIndexOfHash !== text.length - 1) {
		return text;
	}

	return text.substring(0, lastIndexOfHash);
};

// [추가] 헤더 텍스트 앞의 자동 생성된 번호(1. 1.1. 등) 제거
const cleanHeadingText = (text: string) => {
	const textWithoutHash = removeTailingHash(text);
	return textWithoutHash.replace(/^(\d+\.)+\s*/, "");
};

let heading1Count = 1;

const maxLevel = siteConfig.toc.depth;

// [수정] Footnotes 제목 제외 (가장 강력한 필터링)
const filteredHeadings = headings.filter((heading) => {
	const text = heading.text.toLowerCase().trim();
	const slug = heading.slug.toLowerCase();

	const isTooDeep = heading.depth >= minDepth + maxLevel;
	const isFootnote =
		slug.includes("footnote") ||
		slug.includes("각주") ||
		text.includes("footnote") ||
		text === "각주" ||
		text === "footnotes" ||
		heading.depth === 100; // 일부 플러그인에서 숨김용으로 쓰는 트릭 대응

	return !isTooDeep && !isFootnote;
});
---
{shouldShowTOC &&
<table-of-contents class:list={[className, "block relative text-left"]} data-is-floating={isFloating}>
    <div class:list={["w-full", {"toc-inner-wrapper hide-scrollbar flex flex-col pb-24": isFloating}]}>
        <div class="toc w-full h-full">
            {filteredHeadings.map((heading) =>
                <a href={`#${heading.slug}`} class:list={["group pr-4 flex items-start gap-2 relative transition-all duration-100 ease-out w-full min-h-7 rounded-xl hover:bg-[var(--toc-btn-active)] active:bg-[var(--toc-btn-active)] py-1",
                    {"pl-4": !className?.includes("pl-0"), "pl-0": className?.includes("pl-0")}
                ]}>
                    <div class:list={["transition w-5 h-5 shrink-0 rounded-lg text-xs flex items-center justify-center font-bold mt-0.5",
                        {
                            "bg-[var(--toc-badge-bg)] text-[var(--btn-content)]": heading.depth == minDepth,
                            "ml-4": heading.depth == minDepth + 1,
                            "ml-8": heading.depth == minDepth + 2,
                        }
                    ]}
                    >
                        {heading.depth == minDepth && heading1Count++}
                        {heading.depth == minDepth + 1 && <div class="transition w-2 h-2 rounded-[0.1875rem] bg-[var(--toc-badge-bg)]"></div>}
                        {heading.depth == minDepth + 2 && <div class="transition w-1.5 h-1.5 rounded-sm bg-black/5 dark:bg-white/10"></div>}
                    </div>
                    <div class:list={["transition text-sm text-left break-words leading-snug py-0.5 group-hover:text-[oklch(0.20_0.14_var(--hue))] dark:group-hover:text-[var(--primary)]",
                        {"text-black/100 dark:text-white/90": !isFloating},
                        {"text-black/80 dark:text-white/60 [.visible_&]:text-black/100 [.visible_&]:dark:text-white/90": isFloating}
                    ]}>{cleanHeadingText(heading.text)}</div>
                </a>
            )}
            {isFloating && <div class="active-indicator -z-10 absolute bg-[var(--toc-btn-hover)] rounded-xl transition-all duration-100 ease-out pointer-events-none border-2 border-[var(--toc-btn-hover)] group-hover:border-[var(--toc-btn-active)] border-dashed box-border shadow-sm" style="opacity: 0"></div>}
        </div>
    </div>
</table-of-contents>}

<script>
class TableOfContents extends HTMLElement {
    tocEl: HTMLElement | null = null;
    visibleClass = "visible";
    observer: IntersectionObserver;
    anchorNavTarget: HTMLElement | null = null;
    headingIdxMap = new Map<string, number>();
    headings: HTMLElement[] = [];
    sections: HTMLElement[] = [];
    tocEntries: HTMLAnchorElement[] = [];
    active: boolean[] = [];
    activeIndicator: HTMLElement | null = null;
    lastScrollY = 0;
    isScrollingDown = true;

    constructor() {
        super();
        this.observer = new IntersectionObserver(
            this.markVisibleSection, { 
                threshold: 0,
                rootMargin: "-15% 0px 0px 0px"
            }
        );
    };

    markVisibleSection = (entries: IntersectionObserverEntry[]) => {
        this.fallback();
        this.update();
    };

    toggleActiveHeading = () => {
        let activeIdx = -1;

        for (let i = this.active.length - 1; i >= 0; i--) {
            if (this.active[i]) {
                activeIdx = i;
                break;
            }
        }

        this.tocEntries.forEach(entry => entry.classList.remove(this.visibleClass));

        if (activeIdx === -1) {
            this.activeIndicator?.setAttribute("style", `opacity: 0`);
        } else {
            const entry = this.tocEntries[activeIdx];
            entry.classList.add(this.visibleClass);

            const top = entry.offsetTop;
            const left = entry.offsetLeft;
            const width = entry.offsetWidth;
            const height = entry.offsetHeight;
            
            this.activeIndicator?.setAttribute("style", `top: ${top}px; left: ${left}px; width: ${width}px; height: ${height}px; opacity: 1`);
        }
    };

    scrollToActiveHeading = () => {
        if (this.anchorNavTarget || !this.tocEl) return;
        const activeHeading =
            this.querySelectorAll<HTMLDivElement>(`.${this.visibleClass}`);
        if (!activeHeading.length) return;

        const topmost = activeHeading[0];
        const tocHeight = this.tocEl.clientHeight;

        let top = topmost.offsetTop - 32;

        this.tocEl.scrollTo({
            top,
            left: 0,
            behavior: "smooth",
        });
    };

    update = () => {
        requestAnimationFrame(() => {
            this.toggleActiveHeading();
            this.scrollToActiveHeading();
        });
    };

    fallback = () => {
        if (!this.headings.length) return;

        this.active.fill(false);

        // 최상단일 때는 무조건 첫 번째 항목 활성화
        if (window.scrollY < 50) {
            this.active[0] = true;
            return;
        }

        // 스크롤 방향에 따라 기준선을 다르게 설정하여 '지연 현상' 해결
        const downThreshold = window.innerHeight * 0.15;
        const upThreshold = window.innerHeight * 0.1; 
        const thresholdLine = this.isScrollingDown ? downThreshold : upThreshold;

        let currentIdx = -1;
        for (let i = 0; i < this.headings.length; i++) {
            const rect = this.headings[i].getBoundingClientRect();
            if (rect.top <= thresholdLine) {
                currentIdx = i;
            } else {
                break;
            }
        }

        if (currentIdx !== -1) {
            this.active[currentIdx] = true;
        }
    };

    markActiveHeading = (idx: number)=> {
        this.active[idx] = true;
    };

    handleAnchorClick = (event: Event) => {
        const anchor = event
            .composedPath()
            .find((element) => element instanceof HTMLAnchorElement);

        if (anchor) {
            const id = decodeURIComponent(anchor.hash?.substring(1));
            const idx = this.headingIdxMap.get(id);
            if (idx !== undefined) {
                this.anchorNavTarget = this.headings[idx];
            } else {
                this.anchorNavTarget = null;
            }
        }
    };

    handleScroll = () => {
        const currentScrollY = window.scrollY;
        this.isScrollingDown = currentScrollY > this.lastScrollY;
        this.lastScrollY = currentScrollY;
        
        this.fallback();
        this.update();
    };

    isInRange(value: number, min: number, max: number) {
        return min < value && value < max;
    };

    connectedCallback() {
        if (this.dataset.isFloating !== 'true') return;

        const element = document.querySelector('.prose') || document.querySelector('.markdown-content');
        if (element) {
            if (getComputedStyle(element).animationName !== 'none') {
                element.addEventListener('animationend', () => {
                    this.init();
                }, { once: true });
            } else {
                this.init();
            }
        } else {
            this.init();
        }

        this.lastScrollY = window.scrollY;
        window.addEventListener('scroll', this.handleScroll, { passive: true });
    };

    init() {
        this.tocEl = this.querySelector(".toc-inner-wrapper");

        if (!this.tocEl) return;

        this.tocEl.addEventListener("click", this.handleAnchorClick, {
            capture: true,
        });

        this.activeIndicator = this.querySelector(".active-indicator");

        this.tocEntries = Array.from(
            this.querySelectorAll<HTMLAnchorElement>(".toc a[href^='#']")
        );

        if (this.tocEntries.length === 0) return;

        this.headings = new Array(this.tocEntries.length);
        for (let i = 0; i < this.tocEntries.length; i++) {
            const id = decodeURIComponent(this.tocEntries[i].hash?.substring(1));
            const heading = document.getElementById(id);
            if (heading instanceof HTMLElement) {
                this.headings[i] = heading;
                this.headingIdxMap.set(id, i);
            }
        }
        this.active = new Array(this.tocEntries.length).fill(false);

        this.headings.forEach((heading) => {
            if (heading) this.observer.observe(heading);
        });

        this.fallback();
        this.update();
    };

    disconnectedCallback() {
        this.headings.forEach((heading) => {
            if (heading) this.observer.unobserve(heading);
        });
        this.observer.disconnect();
        this.tocEl?.removeEventListener("click", this.handleAnchorClick);
        window.removeEventListener('scroll', this.handleScroll);
    };
}

if (!customElements.get("table-of-contents")) {
    customElements.define("table-of-contents", TableOfContents);
}
</script>
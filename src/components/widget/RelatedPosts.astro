---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { getSortedPosts } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getDir, getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../misc/ImageWrapper.astro";

interface Props {
	entry: CollectionEntry<"posts">; // 현재 포스트 데이터
}

const { entry } = Astro.props;
const allPosts = await getSortedPosts();

// 점수 계산 알고리즘 2.0
const relatedPosts = allPosts
	.filter((post) => post.slug !== entry.slug)
	.map((post) => {
		let score = 0;
		const currentTags = entry.data.tags || [];
		const postTags = post.data.tags || [];
		const currentCategory = entry.data.category || "";
		const postCategory = post.data.category || "";

		// 1. 대분류 격리 (Mismatch Root Category: -5)
		const currentRoot = currentCategory.split("/")[0];
		const postRoot = postCategory.split("/")[0];
		if (currentRoot !== postRoot) score -= 5;

		// 2. 카테고리 완전 일치 (Full Category Match: +2)
		if (currentCategory === postCategory) score += 2;

		// 3. 태그 일치 (Individual Tag Match: +1 each)
		const intersection = postTags.filter((t: string) =>
			currentTags.includes(t),
		);
		score += intersection.length;

		// 4. 첫 번째 태그 일치 (Primary Tag Match: +3)
		if (
			currentTags.length > 0 &&
			postTags.length > 0 &&
			currentTags[0] === postTags[0]
		) {
			score += 3;
		}

		// 5. 태그 일치율 보너스 (Tag Match Rate: Up to +2)
		if (currentTags.length > 0) {
			score += (intersection.length / currentTags.length) * 2;
		}

		// 6. 작성일 차이에 따른 페널티 (Age Penalty: -1 per year)
		const yearDiff = Math.abs(
			entry.data.published.getFullYear() - post.data.published.getFullYear(),
		);
		score -= yearDiff;

		return { post, score };
	})
	.sort((a, b) => {
		if (b.score !== a.score) return b.score - a.score;
		return b.post.data.published.valueOf() - a.post.data.published.valueOf();
	})
	.slice(0, 4);
---

{relatedPosts.length > 0 && (
    <div class="card-base p-3 md:p-6 mb-2 md:mb-4 onload-animation">
        <div class="grid grid-cols-2 gap-3 md:gap-6">
            {relatedPosts.map(({ post }, i) => (
                <a 
                    href={getPostUrlBySlug(post.slug)} 
                    class="group flex flex-col transition-all duration-300 active:scale-[0.98]"
                >
                    {/* Thumbnail & Description Overlay */}
                    <div class="relative aspect-video rounded-md md:rounded-lg overflow-hidden mb-2 md:mb-4 shadow-sm transition-all duration-500" style="mask-image: radial-gradient(white, black); -webkit-mask-image: -webkit-radial-gradient(white, black);">
                        <div class="absolute inset-0 z-0 overflow-hidden rounded-[inherit]">
                            {/* Background Image */}
                            {post.data.image ? (
                                <ImageWrapper 
                                    src={post.data.image} 
                                    basePath={path.join("content", post.collection, post.id.substring(0, post.id.lastIndexOf("/")))} 
                                    alt={post.data.title}
                                    widths={[400, 800]}
                                    sizes="(max-width: 768px) 50vw, 400px"
                                    class="w-full h-full object-cover group-hover:scale-110 md:group-hover:blur-[1px] transition-all duration-700"
                                />
                            ) : (
                                <div class="w-full h-full bg-black/5 dark:bg-white/5 flex items-center justify-center group-hover:bg-[var(--primary)]/10 transition-colors px-4">
                                    <span class="text-base md:text-lg font-black text-black/25 dark:text-white/25 group-hover:opacity-0 transition-all duration-500 uppercase tracking-wider text-center line-clamp-1">
                                        {post.data.tags && post.data.tags.length > 0 ? post.data.tags[0] : "POST"}
                                    </span>
                                </div>
                            )}
                        </div>
                        
                        {/* Description Overlay */}
                        <div class="absolute inset-0 bg-black/40 backdrop-blur-[3px] flex flex-col justify-center px-4 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 pointer-events-none">
                            <p class="text-white text-[14.3px] leading-relaxed line-clamp-3 font-normal text-center [text-wrap:balance] break-keep">
                                {post.data.description || "이 글의 내용을 확인해보세요."}
                            </p>
                        </div>
                    </div>

                    {/* Content Section */}
                    <div class="flex flex-col px-0.5">
                        {/* Tag (Unified Badge Style) */}
                        {post.data.tags && post.data.tags.length > 0 && (
                            <div class="flex mb-1 md:mb-1.5 h-5 md:h-6 overflow-hidden">
                                <span class="inline-flex items-center h-5 md:h-6 px-2 rounded-md bg-black/5 dark:bg-white/10 !text-[var(--primary)] text-[10px] md:text-[11px] font-bold uppercase tracking-wider whitespace-nowrap"
                                      style="font-kerning: normal;">
                                    <Icon name="material-symbols:tag-rounded" class="mr-0.5 text-[11px] md:text-[13px]" />
                                    {post.data.tags[0].replaceAll(' ', '\u00A0')}
                                </span>
                            </div>
                        )}

                        {/* Title */}
                        <div class="text-sm md:text-base font-bold text-90 group-hover:text-[var(--primary)] transition-colors line-clamp-2 break-keep mb-1 md:mb-2 leading-tight md:leading-snug [text-wrap:balance]">
                            {post.data.title}
                        </div>

                        {/* Date */}
                        <div class="text-[11px] md:text-[12px] text-black/30 dark:text-white/30">
                            {formatDateToYYYYMMDD(post.data.published)}
                        </div>
                    </div>
                </a>
            ))}
        </div>
    </div>
)}
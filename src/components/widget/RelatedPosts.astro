---
import { getSortedPosts } from "@utils/content-utils";
import { getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { formatDateToYYYYMMDD } from "@utils/date-utils";

interface Props {
	entry: any; // 현재 포스트 데이터
}

const { entry } = Astro.props;
const allPosts = await getSortedPosts();

// 점수 계산 알고리즘
const relatedPosts = allPosts
	.filter((post) => post.slug !== entry.slug) // 자기 자신 제외
	.map((post) => {
		let score = 0;

		const currentTags = entry.data.tags || [];
		const postTags = post.data.tags || [];
		const currentCategory = entry.data.category;
		const postCategory = post.data.category;

		// 1. 카테고리 일치 (+2점)
		if (currentCategory && postCategory && currentCategory === postCategory) {
			score += 2;
		}

		// 2. 태그 일치 (개당 +1점)
		const intersection = postTags.filter((t: string) => currentTags.includes(t));
		score += intersection.length;

		// 3. 첫 번째 태그(Primary Tag) 일치 (+3점) - 가장 강력한 연관성
		if (
			currentTags.length > 0 &&
			postTags.length > 0 &&
			currentTags[0] === postTags[0]
		) {
			score += 3;
		}

		return { post, score };
	})
	.filter((item) => item.score > 0) // 점수가 0인(연관성 없는) 글 제외
	.sort((a, b) => b.score - a.score || b.post.data.published.valueOf() - a.post.data.published.valueOf()) // 점수 내림차순 -> 최신순 정렬
	.slice(0, 5); // 상위 5개만 추출
---

{relatedPosts.length > 0 && (
    <div class="card-base p-6 mb-4 onload-animation">
        <div class="flex items-center gap-2 mb-4 text-xl font-bold text-90 transition relative">
            <Icon name="material-symbols:auto-awesome-outline-rounded" class="text-[var(--primary)] text-2xl" />
            <span>추천글</span>
        </div>
        
        <div class="grid grid-cols-1 gap-4">
            {relatedPosts.map(({ post }) => (
                <a 
                    href={getPostUrlBySlug(post.slug)} 
                    class="group flex flex-col md:flex-row gap-2 md:gap-4 items-start md:items-center p-3 rounded-lg hover:bg-[var(--btn-plain-bg-hover)] transition-colors"
                >
                    <div class="flex-1">
                        <div class="text-sm font-medium text-90 group-hover:text-[var(--primary)] transition-colors mb-1 line-clamp-1 break-keep">
                            {post.data.title}
                        </div>
                        <div class="flex flex-wrap items-center gap-2 text-xs text-50">
                            <span class="flex items-center gap-1">
                                <Icon name="material-symbols:edit-calendar-rounded" />
                                {formatDateToYYYYMMDD(post.data.published)}
                            </span>
                            {post.data.tags && post.data.tags.length > 0 && (
                                <>
                                    <span class="opacity-50">·</span>
                                    <span class="flex items-center gap-1">
                                        <Icon name="material-symbols:tag-rounded" class="text-[var(--primary)]" />
                                        {post.data.tags[0]}
                                    </span>
                                </>
                            )}
                        </div>
                    </div>
                </a>
            ))}
        </div>
    </div>
)}

---
import { Icon } from "astro-icon/components";
import { type NavBarLink } from "../../types/config";
import { url, getCategoryUrl } from "../../utils/url-utils";
import { getCategoryList, getSortedPosts } from "../../utils/content-utils";

interface Props {
	links: NavBarLink[];
}

const { links } = Astro.props;
const categories = await getCategoryList();
const allPosts = await getSortedPosts();

// 현재 경로 및 독서 중인 포스트 정보 확인
const currentUrl = new URL(Astro.request.url);
const activeCategory = currentUrl.searchParams.get("category");
const isPostPage = !!Astro.params.slug;
let postCategory = "";

if (isPostPage) {
    const currentPost = allPosts.find((p) => p.slug === Astro.params.slug);
    postCategory = currentPost?.data.category || "";
}
---
<div id="nav-menu-panel" class:list={["float-panel float-panel-closed transition-all fixed right-0 top-[72px] p-3 min-w-[16rem] max-h-[calc(100vh-72px)] overflow-y-auto custom-scrollbar shadow-2xl rounded-l-2xl border-l border-b border-black/5 dark:border-white/5 bg-[var(--card-bg)]/95 backdrop-blur-md"]}>
    {/* 상단 기본 링크 - 태블릿 이상에서는 네비바와 중복되므로 숨김 */}
    <div class="flex flex-col mb-1 md:hidden">
        {/* 페이지 헤더 */}
        <div class="menu-item px-4 py-2 flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.2em] text-black/60 dark:text-white/60 select-none"
             style="--i: 0; font-feature-settings: 'case' 1, 'cpsp' 1; font-kerning: normal;">
            <Icon name="material-symbols:layers-outline-rounded" class="text-[1.15rem] text-[var(--primary)] opacity-100 -translate-y-[0.5px]" />
            <span class="leading-none">Pages</span>
        </div>

        {links.map((link, index) => (
            <a href={link.external ? link.url : url(link.url)} 
               class="menu-item group flex justify-between items-center py-3 pl-4 pr-2 rounded-xl gap-8 hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)] transition-all duration-300"
               style={`--i: ${index + 1}`}
               target={link.external ? "_blank" : null}
            >
                <div class="transition text-black/75 dark:text-white/75 font-bold group-hover:text-[var(--primary)] group-active:text-[var(--primary)] text-sm">
                    {link.name}
                </div>
            </a>
        ))}
        {/* 구분선 - 모바일에서만 노출 */}
        <div class="mx-4 my-2 border-t border-black/[0.12] dark:border-white/[0.12]"></div>
    </div>

    {/* 카테고리 헤더 */}
    <div class="menu-item px-4 py-2 mt-2 flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.2em] text-black/60 dark:text-white/60 select-none"
         style={`--i: ${links.length + 1}; font-feature-settings: "case" 1, "cpsp" 1; font-kerning: normal;`}>
        <Icon name="material-symbols:folder-open-outline-rounded" class="text-base text-[var(--primary)] opacity-100 -translate-y-[0.5px]" />
        <span class="leading-none">Categories</span>
    </div>

    {/* 카테고리 목록 */}
    <div class="flex flex-col pb-2">
        {categories.map((cat, index) => {
            const isActive = activeCategory === cat.name;
            const isReading = isPostPage && postCategory === cat.name;
            const parts = cat.name.split('/');
            const depth = parts.length; // 1, 2, 3 등
            const totalIndex = links.length + 2 + index;
            
            return (
                <a href={getCategoryUrl(cat.name)} 
                   class="menu-item group flex justify-between items-center py-3 pr-2 rounded-xl transition-all duration-300"
                   style={`--i: ${totalIndex}`}
                   class:list={[
                    (isActive || isReading) ? "bg-[var(--primary)]/[0.08]" : "hover:bg-[var(--btn-plain-bg-hover)]",
                    depth === 1 ? "pl-4" : depth === 2 ? "pl-9" : "pl-14",
                    { "reading-active-star": isReading }
                ]}>
                    <div class:list={[
                        "text-sm transition-colors duration-300 flex items-center",
                        (isActive || isReading) ? "text-[var(--primary)]" : "text-black/70 dark:text-white/70 group-hover:text-[var(--primary)]",
                        depth === 1 ? "font-extrabold text-[15px]" : "font-normal text-[15px]"
                    ]}
                    style={depth === 3 ? "font-kerning: normal;" : ""}
                    >
                        <span class="category-label capitalize leading-none">{parts[parts.length - 1]}</span>
                    </div>
                </a>
            )
        })}
    </div>
</div>

<style>
    /* 독서 모드 별표(*) 포인트 (선명하게 표시) */
    .reading-active-star .category-label::after {
        content: "*";
        display: inline-block;
        color: var(--primary);
        font-weight: 900;
        font-size: 1.25rem;
        margin-left: 2px;
        vertical-align: top;
        line-height: 1;
        opacity: 0; /* 초기 상태: 투명 */
        animation: pulse-opacity 1.5s ease-in-out infinite;
        animation-delay: 0.5s; /* 0.5초 대기 후 시작 */
    }

    @keyframes pulse-opacity {
        0% { opacity: 0; }
        50% { opacity: 1; }
        100% { opacity: 0; }
    }

    #nav-menu-panel {
        /* [모바일 기본] 열기: 0.5초 (기존 속도) */
        transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), 
                    opacity 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
                    visibility 0.5s;
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
    }

    /* [태블릿 이상] 목록이 짧으므로 더 빠르게 (0.35초) */
    @media (min-width: 768px) {
        #nav-menu-panel {
            transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), 
                        opacity 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                        visibility 0.35s;
        }
    }

    :global(.float-panel-closed)#nav-menu-panel {
        /* [모바일 기본] 닫기: 0.2초 (기존 속도) */
        transition: transform 0.2s ease-in, 
                    opacity 0.2s ease-in,
                    visibility 0.2s;
        transform: translateY(-15px);
        opacity: 0;
        visibility: hidden;
    }

    /* [태블릿 이상] 닫기: 0.15초 */
    @media (min-width: 768px) {
        :global(.float-panel-closed)#nav-menu-panel {
            transition: transform 0.15s ease-in, 
                        opacity 0.15s ease-in,
                        visibility 0.15s;
        }
    }

    /* 개별 메뉴 항목 "차르륵" 등장 효과 */
    .menu-item {
        opacity: 0;
        transform: translateY(-12px);
        /* [모바일 기본] 등장: 0.5초, 딜레이 0.05초 */
        transition: opacity 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), 
                    transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
                    background-color 0.3s ease,
                    color 0.3s ease;
        transition-delay: calc(var(--i) * 0.05s), calc(var(--i) * 0.05s), 0s, 0s;
    }

    /* [태블릿 이상] 등장: 0.35초, 딜레이 0.035초 */
    @media (min-width: 768px) {
        .menu-item {
            transition: opacity 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), 
                        transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                        background-color 0.3s ease,
                        color 0.3s ease;
            transition-delay: calc(var(--i) * 0.035s), calc(var(--i) * 0.035s), 0s, 0s;
        }
    }

    /* 호버 시에는 모든 지연 시간을 제거하여 즉시 반응 */
    .menu-item:hover {
        transition-delay: 0s !important;
    }

    /* 패널이 열렸을 때 */
    #nav-menu-panel:not(.float-panel-closed) .menu-item {
        opacity: 1;
        transform: translateY(0);
    }

    /* 패널이 닫힐 때: 지연 없이 신속하게 퇴장 */
    :global(.float-panel-closed) .menu-item {
        opacity: 0;
        transform: translateY(-12px);
        /* [모바일 기본] 퇴장: 0.2초 */
        transition: opacity 0.2s ease-in, transform 0.2s ease-in;
        transition-delay: 0s !important;
    }

    /* [태블릿 이상] 퇴장: 0.15초 */
    @media (min-width: 768px) {
        :global(.float-panel-closed) .menu-item {
            transition: opacity 0.15s ease-in, transform 0.15s ease-in;
        }
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(0,0,0,0.1);
        border-radius: 10px;
    }
    :global(.dark) .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.1);
    }
</style>

<script>
    const panel = document.getElementById("nav-menu-panel");
    const links = panel?.querySelectorAll("a");

    function updateMenuState() {
        const path = window.location.pathname;
        const pathname = path.endsWith('/') ? path : `${path}/`;
        const urlParams = new URLSearchParams(window.location.search);
        const isPostPage = pathname.includes('/posts/');
        const menuItems = document.querySelectorAll('#nav-menu-panel .menu-item');
        
        // 1. [초기화] 모든 항목의 활성 상태 클래스 제거
        menuItems.forEach(item => {
            item.classList.remove('reading-active-star', 'bg-[var(--primary)]/[0.08]');
            const label = item.querySelector('.category-label');
            if (label) {
                label.classList.remove('text-[var(--primary)]');
                label.classList.add('text-black/70', 'dark:text-white/70');
            }
        });

        let activeCategory = urlParams.get('category');

        // 2. 포스트 페이지일 경우, 현재 본문의 카테고리 링크를 찾아 정보 추출
        if (isPostPage) {
            // [수정] 더 구체적인 셀렉터로 현재 포스트의 카테고리 추출
            const postCategoryLink = document.querySelector('.prose a[href*="category="], #post-container a[href*="category="]');
            if (postCategoryLink) {
                const search = new URL((postCategoryLink as HTMLAnchorElement).href, window.location.origin).search;
                activeCategory = new URLSearchParams(search).get('category');
            }
        }

        menuItems.forEach(item => {
            const hrefAttr = item.getAttribute('href');
            if (!hrefAttr) return;

            const itemUrl = new URL(hrefAttr, window.location.origin);
            const itemPath = itemUrl.pathname.endsWith('/') ? itemUrl.pathname : `${itemUrl.pathname}/`;
            const itemCategory = itemUrl.searchParams.get('category');
            const label = item.querySelector('.category-label');
            
            // 3. 카테고리 활성 상태 확인 (일반 카테고리 뷰 또는 포스트 읽기 중)
            // [강화] 완전 일치(Exact Match) 확인
            if (activeCategory && itemCategory === activeCategory) {
                item.classList.add('bg-[var(--primary)]/[0.08]');
                if (label) {
                    label.classList.add('text-[var(--primary)]');
                    label.classList.remove('text-black/70', 'dark:text-white/70');
                }
                if (isPostPage) {
                    item.classList.add('reading-active-star');
                }
            }
            
            // 4. 현재 URL과 정확히 일치하는 항목 (Home, Archive 등 기본 링크)
            if (!activeCategory && !itemCategory && pathname === itemPath && itemPath !== '/') {
                item.classList.add('bg-[var(--primary)]/[0.08]');
                if (label) {
                    label.classList.add('text-[var(--primary)]');
                    label.classList.remove('text-black/70', 'dark:text-white/70');
                }
            }
            
            // 홈(Root) 예외 처리
            if (!activeCategory && pathname === '/' && itemPath === '/') {
                item.classList.add('bg-[var(--primary)]/[0.08]');
                if (label) label.classList.add('text-[var(--primary)]');
            }
        });
    }

    if (panel && links) {
        links.forEach((link) => {
            link.addEventListener("click", () => {
                if (!link.getAttribute("href")?.startsWith("#")) {
                   panel.classList.add("float-panel-closed");
                }
            });
        });
    }

    // Swup 전환 및 페이지 로드 시마다 메뉴 상태를 다시 계산
    document.addEventListener('swup:content:replace', () => {
        // 컨텐츠 교체 후 DOM이 안정화될 시간을 짧게 부여
        setTimeout(updateMenuState, 10);
    });
    document.addEventListener('astro:page-load', updateMenuState);
    
    // 페이지 로드 시 시작 시 메뉴를 무조건 닫음 (기존 로직 유지)
    document.addEventListener('swup:visit:start', () => {
        panel?.classList.add("float-panel-closed");
    });
</script>

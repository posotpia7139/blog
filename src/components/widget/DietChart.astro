---
import { dietHistory } from "../../data/dietHistory";

// 최저 및 최고 몸무게 계산
const weights = dietHistory.map(d => d.weight);
const minWeight = Math.min(...weights);
const maxWeight = Math.max(...weights);
---

<div class="diet-chart-container w-full mt-12 mb-6">
    <div class="overflow-hidden rounded-lg border border-black/10 dark:border-white/10 bg-[var(--card-bg)] mb-6 p-4">
        <div class="flex items-center justify-between mb-4 px-2">
            <div class="text-lg font-bold text-black/90 dark:text-white/90">
                체중 변화 추이
            </div>
            <button id="resetZoom" class="text-xs px-2 py-1 rounded bg-black/5 dark:bg-white/10 hover:bg-black/10 dark:hover:bg-white/20 transition-colors text-black/50 dark:text-white/50">
                초기화
            </button>
        </div>
        <div class="relative w-full h-64 md:h-80">
            <canvas id="weightChart"></canvas>
        </div>
    </div>

    <div class="overflow-hidden rounded-lg border border-black/10 dark:border-white/10 bg-[var(--card-bg)]">
        <div class="overflow-x-auto max-h-[500px] overflow-y-auto custom-scrollbar">
            <table class="w-full text-sm text-left border-collapse">
                <thead class="sticky top-0 z-20 bg-[var(--card-bg)] shadow-[0_1px_0_rgba(0,0,0,0.1)] dark:shadow-[0_1px_0_rgba(255,255,255,0.1)]">
                    <tr class="bg-black/5 dark:bg-white/5 text-black/90 dark:text-white/90">
                        <th colspan="4" class="px-4 py-4 text-center text-lg font-bold">
                            전체 체중 변화 기록표
                        </th>
                    </tr>
                    <tr class="text-xs uppercase bg-black/5 dark:bg-white/5 text-black/70 dark:text-white/70">
                        <th scope="col" class="px-4 py-3 text-center whitespace-nowrap font-bold">날짜</th>
                        <th scope="col" class="px-4 py-3 text-center whitespace-nowrap font-bold">체중 (kg)</th>
                        <th scope="col" class="px-4 py-3 text-center whitespace-nowrap font-bold">누적 변화</th>
                        <th scope="col" class="px-4 py-3 text-left whitespace-nowrap font-bold">비고</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-black/10 dark:divide-white/10">
                    {dietHistory.slice().reverse().map((record) => {
                        const isMin = record.weight === minWeight;
                        const isMax = record.weight === maxWeight;
                        
                        return (
                            <tr class:list={[
                                "transition-colors duration-200",
                                isMin ? "bg-green-500/5 hover:bg-green-500/10" : 
                                isMax ? "bg-red-500/5 hover:bg-red-500/10" : 
                                "hover:bg-black/5 dark:hover:bg-white/5"
                            ]}>
                                <td class="px-4 py-3 text-center font-medium whitespace-nowrap text-black/90 dark:text-white/90">{record.date}</td>
                                <td class="px-4 py-3 text-center font-bold text-black/90 dark:text-white/90">
                                    <div class="flex items-center justify-center gap-1.5">
                                        {record.weight}
                                        {isMin && <span title="최저 몸무게" class="text-xs">🏆</span>}
                                        {isMax && <span title="최고 몸무게" class="text-xs">⚠️</span>}
                                    </div>
                                </td>
                                <td class:list={["px-4 py-3 text-center font-bold", 
                                    {"text-red-600 dark:text-red-400": record.change.startsWith('+'),
                                     "text-blue-600 dark:text-blue-400": record.change.startsWith('-'),
                                     "text-black/50 dark:text-white/50": !record.change.startsWith('+') && !record.change.startsWith('-')}
                                ]}>
                                    {record.change}
                                </td>
                                <td class="px-4 py-3 text-left text-black/60 dark:text-white/60 text-xs">{record.note || '-'}</td>
                            </tr>
                        )
                    })}
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="text-right text-xs text-black/40 dark:text-white/40 mt-2">
        * 🏆 최저점 / ⚠️ 최고점 하이라이트 포함.
    </div>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: rgba(0, 0, 0, 0.1);
        border-radius: 20px;
    }
    :global(.dark) .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: rgba(255, 255, 255, 0.1);
    }
</style>

<script>
    import Chart from 'chart.js/auto';
    import zoomPlugin from 'chartjs-plugin-zoom';
    import { dietHistory } from "../../data/dietHistory";

    Chart.register(zoomPlugin);

    function initChart() {
        const ctx = document.getElementById('weightChart') as HTMLCanvasElement;
        if (!ctx) return;

        const existingChart = Chart.getChart(ctx);
        if (existingChart) existingChart.destroy();

        const isDark = document.documentElement.classList.contains('dark');
        const gridColor = isDark ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.1)';
        const textColor = isDark ? 'rgba(255, 255, 255, 0.7)' : 'rgba(0, 0, 0, 0.7)';
        const primaryColor = getComputedStyle(document.documentElement).getPropertyValue('--primary').trim() || '#3b82f6';

        const labels = dietHistory.map(d => d.date.substring(5));
        const data = dietHistory.map(d => d.weight);
        const notes = dietHistory.map(d => d.note); // 비고 데이터
        const targetData = new Array(dietHistory.length).fill(65);

        // 초기 뷰 범위 설정 (최근 15개 데이터만 보여줌)
        const initialRange = 15;
        const xMin = Math.max(0, labels.length - initialRange);
        const xMax = labels.length - 1;

        // 비고가 있는 데이터 포인트 강조 설정
        const pointRadii = notes.map(note => note ? 6 : 3);
        const pointHoverRadii = notes.map(note => note ? 9 : 6);
        const pointColors = notes.map(note => note ? '#f59e0b' : primaryColor); // Amber 500 for notes

        // 몸무게 구간별 배경색 설정
        const zones = [
            { threshold: 110, color: isDark ? 'rgba(239, 68, 68, 0.08)' : 'rgba(239, 68, 68, 0.05)' }, // Red
            { threshold: 100, color: isDark ? 'rgba(245, 158, 11, 0.08)' : 'rgba(245, 158, 11, 0.05)' }, // Amber
            { threshold: 90, color: isDark ? 'rgba(59, 130, 246, 0.08)' : 'rgba(59, 130, 246, 0.05)' },  // Blue
            { threshold: 80, color: isDark ? 'rgba(16, 185, 129, 0.08)' : 'rgba(16, 185, 129, 0.05)' }, // Emerald
            { threshold: 70, color: isDark ? 'rgba(34, 197, 94, 0.08)' : 'rgba(34, 197, 94, 0.05)' },  // Green
            { threshold: 60, color: isDark ? 'rgba(6, 182, 212, 0.08)' : 'rgba(6, 182, 212, 0.05)' },  // Cyan
        ];

        const backgroundPlugin = {
            id: 'customBackground',
            beforeDraw: (chart) => {
                const { ctx, chartArea: { top, bottom, left, right }, scales: { y } } = chart;
                ctx.save();

                // 구간별 배경 칠하기
                const sortedThresholds = [y.max, ...zones.map(z => z.threshold), y.min].sort((a, b) => b - a);
                
                for (let i = 0; i < sortedThresholds.length - 1; i++) {
                    const upper = sortedThresholds[i];
                    const lower = sortedThresholds[i+1];
                    const zone = zones.find(z => z.threshold <= upper) || zones[zones.length - 1];
                    
                    const yTop = Math.max(top, y.getPixelForValue(upper));
                    const yBottom = Math.min(bottom, y.getPixelForValue(lower));
                    
                    if (yTop < yBottom) {
                        ctx.fillStyle = zone.color;
                        ctx.fillRect(left, yTop, right - left, yBottom - yTop);
                    }
                }

                // 주요 경계선 (100kg 등) 강조
                [100, 80, 65].forEach(val => {
                    const yPos = y.getPixelForValue(val);
                    if (yPos >= top && yPos <= bottom) {
                        ctx.beginPath();
                        ctx.moveTo(left, yPos);
                        ctx.lineTo(right, yPos);
                        ctx.strokeStyle = isDark ? 'rgba(255, 255, 255, 0.15)' : 'rgba(0, 0, 0, 0.08)';
                        ctx.setLineDash([5, 5]);
                        ctx.stroke();
                    }
                });

                ctx.restore();
            }
        };

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: '체중 (kg)',
                        data: data,
                        borderColor: primaryColor,
                        backgroundColor: isDark ? 'rgba(59, 130, 246, 0.1)' : 'rgba(59, 130, 246, 0.1)',
                        borderWidth: 2,
                        tension: 0.3,
                        pointRadius: pointRadii,
                        pointHoverRadius: pointHoverRadii,
                        pointBackgroundColor: pointColors,
                        pointBorderColor: isDark ? '#1a1a1a' : '#ffffff',
                        fill: true
                    },
                    {
                        label: '목표 (65kg)',
                        data: targetData,
                        borderColor: '#10b981',
                        borderWidth: 1,
                        borderDash: [5, 5],
                        pointRadius: 0,
                        fill: false,
                        hidden: true
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'nearest',
                    intersect: true,
                },
                plugins: {
                    legend: {
                        labels: { color: textColor }
                    },
                    tooltip: {
                        backgroundColor: isDark ? 'rgba(0, 0, 0, 0.9)' : 'rgba(255, 255, 255, 0.95)',
                        titleColor: isDark ? '#fff' : '#000',
                        bodyColor: isDark ? '#ccc' : '#333',
                        borderColor: gridColor,
                        borderWidth: 1,
                        padding: 10,
                        callbacks: {
                            afterLabel: function(context) {
                                const index = context.dataIndex;
                                const note = notes[index];
                                if (note) {
                                    return '\n💡 ' + note;
                                }
                                return null;
                            }
                        }
                    },
                    zoom: {
                        pan: {
                            enabled: true,
                            mode: 'x',
                        },
                        zoom: {
                            wheel: {
                                enabled: true,
                            },
                            pinch: {
                                enabled: true
                            },
                            mode: 'x',
                        },
                        limits: {
                            x: {min: 0, max: labels.length - 1, minRange: 4}
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { color: gridColor },
                        ticks: { color: textColor, maxRotation: 0, minRotation: 0 },
                        min: xMin, // 초기 줌 상태 설정
                        max: xMax
                    },
                    y: {
                        grid: { color: gridColor },
                        ticks: { color: textColor }
                    }
                }
            },
            plugins: [backgroundPlugin]
        });

        // 줌 초기화 버튼 이벤트 연결
        const resetBtn = document.getElementById('resetZoom');
        if (resetBtn) {
            resetBtn.onclick = () => {
                const chart = Chart.getChart(ctx);
                if (chart) chart.resetZoom();
            };
        }
    }

    initChart();
    document.addEventListener('astro:page-load', initChart);
    
    const observer = new MutationObserver(() => {
        initChart();
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
</script>

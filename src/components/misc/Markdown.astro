---
import "@fontsource-variable/jetbrains-mono/index.css";
import "@fontsource-variable/jetbrains-mono/wght-italic.css";
import "photoswipe/style.css";
import "../../styles/photoswipe.css";

interface Props {
	class: string;
}
const className = Astro.props.class;
---
<div data-pagefind-body class={`prose dark:prose-invert prose-base !max-w-none custom-md ${className}`}>
    <!--<div class="prose dark:prose-invert max-w-none custom-md">-->
    <!--<div class="max-w-none custom-md">-->
    <slot/>
</div>

<script>
// 각주 호버 툴팁 기능 구현
function setupFootnoteTooltips() {
    const footnoteRefs = document.querySelectorAll('a[id^="user-content-fnref-"]');
    
    footnoteRefs.forEach(ref => {
        ref.addEventListener('mouseenter', () => {
            const href = (ref as HTMLAnchorElement).getAttribute('href');
            if (!href) return;
            
            const targetId = decodeURIComponent(href.slice(1));
            const footnoteContent = document.getElementById(targetId);
            
            if (footnoteContent) {
                // 기존 툴팁 제거
                const oldTooltip = document.querySelector('.footnote-tooltip');
                if (oldTooltip) oldTooltip.remove();

                const tooltip = document.createElement('div');
                tooltip.className = 'footnote-tooltip';
                
                // 각주 내용에서 리턴 링크를 제외한 텍스트 추출
                const contentClone = footnoteContent.cloneNode(true) as HTMLElement;
                const backLink = contentClone.querySelector('.data-footnote-backref');
                if (backLink) backLink.remove();
                
                tooltip.innerHTML = contentClone.innerHTML;
                document.body.appendChild(tooltip);

                // 위치 계산 (중앙 정렬 및 간격 확대)
                const rect = ref.getBoundingClientRect();
                const tooltipWidth = tooltip.offsetWidth;
                
                // 번호의 중앙에 팝업의 중앙을 맞춤
                let left = rect.left + window.scrollX + (rect.width / 2) - (tooltipWidth / 2);
                let top = rect.top + window.scrollY - tooltip.offsetHeight - 17.5; // 간격을 17.5px로 확대
                
                tooltip.style.left = `${left}px`;
                tooltip.style.top = `${top}px`;
                
                // 화면 밖으로 나가지 않게 최종 조정
                const padding = 20;
                if (left < padding) {
                    tooltip.style.left = `${padding}px`;
                } else if (left + tooltipWidth > window.innerWidth - padding) {
                    tooltip.style.left = `${window.innerWidth - tooltipWidth - padding}px`;
                }
                
                if (rect.top - tooltip.offsetHeight - 17.5 < 0) {
                    tooltip.style.top = `${rect.bottom + window.scrollY + 17.5}px`;
                }

                // 팝업 자체에서도 마우스가 나가면 사라지게 함
                tooltip.addEventListener('mouseleave', () => {
                    tooltip.remove();
                });
            }
        });

        // 팝업 내부로 마우스 이동 시 유지되도록 개선 (선택 사항이나 UX 향상)
        ref.addEventListener('mouseleave', () => {
            const tooltip = document.querySelector('.footnote-tooltip');
            if (tooltip) {
                // 약간의 유예 시간을 주어 팝업으로 마우스를 옮길 수 있게 함
                setTimeout(() => {
                    if (!tooltip.matches(':hover')) {
                        tooltip.remove();
                    }
                }, 100);
            }
        });
    });
}

// 캡처링 단계에서 이벤트를 가로채어 번호 클릭 시 제목으로 튀는 현상 방지
document.addEventListener("click", function (e: MouseEvent) {
    const target = e.target as Element | null;
    if (!target) return;

    // 1. 헤딩 번호(.section-num) 클릭 시 본문 상단 TOC로 즉시(Instant) 이동
    const sectionNum = target.closest(".section-num");
    if (sectionNum) {
        // 가장 먼저 모든 동작 차단
        e.preventDefault();
        e.stopImmediatePropagation();
        
        const topToc = document.getElementById('top-toc-container');
        
        if (topToc) {
            // 1. 가변값: 본문 컨테이너의 실제 패딩을 실시간으로 읽어옴
            let basePadding = 28;
            const postContainer = document.getElementById('post-container');
            if (postContainer) {
                basePadding = parseInt(window.getComputedStyle(postContainer).paddingLeft) || 28;
            }

            // 2. 조정값: 여기에 원하는 만큼의 추가 여백을 입력 (예: -15)
            const adjustment = -15; 

            // 최종 오프셋 적용
            const totalOffset = basePadding + adjustment;
            const y = topToc.getBoundingClientRect().top + window.scrollY - totalOffset;
            
            window.scrollTo({ top: y, behavior: 'auto' });
        }
    }
}, { capture: true });

document.addEventListener("click", function (e: MouseEvent) {
    const target = e.target as Element | null;
    if (!target) return;

    // 2. 앵커 링크(제목 영역) 클릭 시 주소 복사 및 이동
    const anchorLink = target.closest(".anchor-link");
    if (anchorLink && !target.closest(".section-num")) {
        const url = new URL(window.location.href);
        const hash = anchorLink.getAttribute("href") || "";
        url.hash = hash;
        navigator.clipboard.writeText(url.toString());
    }

    if (target && target.classList.contains("copy-btn")) {
        const preEle = target.closest("pre");
        const codeEle = preEle?.querySelector("code");
        const code = Array.from(codeEle?.querySelectorAll(".code:not(summary *)") ?? [])
            .map(el => el.textContent)
            .map(t => t === "\n" ? "" : t)
            .join("\n");
        navigator.clipboard.writeText(code);

        const timeoutId = target.getAttribute("data-timeout-id");
        if (timeoutId) {
            clearTimeout(parseInt(timeoutId));
        }

        target.classList.add("success");

        const newTimeoutId = setTimeout(() => {
            target.classList.remove("success");
        }, 1000);

        target.setAttribute("data-timeout-id", newTimeoutId.toString());
    }
});

// 이미지 호버 시 alt 설명 툴팁 표시 기능 구현
let tooltipTimeout: ReturnType<typeof setTimeout> | null = null;

function setupImageTooltips() {
    const images = document.querySelectorAll('.custom-md img, #post-cover img');
    let tooltip = document.querySelector('.image-alt-tooltip') as HTMLElement;

    // 전역 툴팁 요소가 없으면 하나만 생성
    if (!tooltip) {
        tooltip = document.createElement('div');
        tooltip.className = 'image-alt-tooltip';
        document.body.appendChild(tooltip);
    }
    
    images.forEach(img => {
        const handleMouseEnter = () => {
            if (tooltipTimeout) clearTimeout(tooltipTimeout);

            // 0.3초 이상 머물 때만 실행 (응답성 상향)
            tooltipTimeout = setTimeout(() => {
                const rawAlt = (img as HTMLImageElement).getAttribute('alt') || "";
                const altText = rawAlt.trim();
                if (!altText || altText === "") return;
                
                tooltip.textContent = altText;

                // 위치 계산 (이미지의 중앙 하단 "안쪽" 정렬)
                const rect = img.getBoundingClientRect();
                
                // 가로 중앙, 세로 하단(안쪽 12px 여백) 계산
                let left = rect.left + window.scrollX + (rect.width / 2);
                let top = rect.bottom + window.scrollY - tooltip.offsetHeight - 12;
                
                tooltip.style.left = `${left}px`;
                tooltip.style.top = `${top}px`;
                
                tooltip.classList.add('visible');
            }, 300);
        };

        const handleMouseLeave = () => {
            if (tooltipTimeout) {
                clearTimeout(tooltipTimeout);
                tooltipTimeout = null;
            }
            tooltip.classList.remove('visible');
        };

        img.addEventListener('mouseenter', handleMouseEnter);
        img.addEventListener('mouseleave', handleMouseLeave);
    });
}

// 툴팁 잔상 및 예약된 타이머 제거 (청소부 기능)
function cleanupTooltips() {
    if (tooltipTimeout) {
        clearTimeout(tooltipTimeout);
        tooltipTimeout = null;
    }
    const tooltip = document.querySelector('.image-alt-tooltip');
    if (tooltip) {
        tooltip.classList.remove('visible');
    }
}

// [수정] 즉시 실행 제거 및 중복 실행 방지 가드 추가
document.addEventListener('astro:page-load', () => {
    if (window.markdownInitialized) return;
    window.markdownInitialized = true;

    setupFootnoteTooltips();
    setupImageTooltips();
});

// 페이지 전환 시 가드 해제
document.addEventListener('swup:content:replace', () => {
    window.markdownInitialized = false;
});

// Swup 전환 시 모든 상태에서 툴팁 숨김 강제
document.addEventListener('swup:visit:start', cleanupTooltips);
document.addEventListener('swup:content:replace', cleanupTooltips);
</script>

<style is:global>
    .footnote-tooltip {
        position: absolute;
        z-index: 100;
        max-width: 20rem;
        padding: 1rem;
        background: #ffffff;
        border: none;
        border-radius: 1rem;
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.15);
        font-size: 0.875rem;
        line-height: 1.625;
        color: #1a1a1a !important;
        pointer-events: auto; /* none에서 auto로 변경하여 상호작용 허용 */
        /* animation 제거됨 */
    }

    /* 팝업 위에 마우스가 있을 때도 유지 */
    .footnote-tooltip:hover {
        display: block;
    }

    /* 다크 모드 스타일 */
    .dark .footnote-tooltip {
        background: #2a2a2a !important;
        border: none !important;
        box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6) !important;
    }

    .dark .footnote-tooltip,
    .dark .footnote-tooltip * {
        color: #f1f1f1 !important;
    }

    /* 이미지 alt 툴팁 스타일 (세련된 미니멀 디자인) */
    .image-alt-tooltip {
        position: absolute;
        z-index: 100;
        padding: 0.3rem 0.5rem;
        background: rgba(15, 15, 15, 0.75);
        color: rgba(255, 255, 255, 0.95) !important;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.5rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        pointer-events: none;
        backdrop-filter: blur(4px) saturate(120%);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
        
        /* 텍스트 크기에 딱 맞는 박스 형성 */
        max-width: 18rem;
        width: max-content;
        display: block;
        text-wrap: balance;
        word-break: keep-all;
        line-height: 1.45;
        text-align: center;
        
        /* 트랜지션 및 가로 중앙 정렬 설정 */
        opacity: 0;
        visibility: hidden;
        transform: translate(-50%, 6px);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .image-alt-tooltip.visible {
        opacity: 1;
        visibility: visible;
        transform: translate(-50%, 0);
    }

    .dark .image-alt-tooltip {
        background: rgba(15, 15, 15, 0.75);
        color: rgba(255, 255, 255, 0.95) !important;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    p { margin: 0; }
    
    /* 팝업 내부의 [1] 번호 링크 색상 강조 */
    .footnote-tooltip .custom-footnote-link,
    .footnote-tooltip .custom-footnote-link span {
        color: var(--primary) !important;
        @apply font-bold;
    }

    .footnote-tooltip code {
        background: var(--code-bg);
        padding: 0.125rem 0.25rem;
        border-radius: 0.25rem;
        font-size: 0.8125rem;
    }

    hr {
        @apply border-dashed border-[var(--line-color)];
        border-top-width: 3px;
    }

    blockquote {
        @apply not-italic border-transparent relative;
        font-weight: inherit;

        &:before {
            @apply content-[''] absolute -left-1.5 block transition h-full w-[0.28125rem] rounded-full bg-[var(--primary)] opacity-40;
        }

        /* Remove the double quotes from default styles */
        p:before, p:after {
            @apply content-none;
        }

    }

    .katex-display-container {
        max-width: 100%;
        overflow-x: auto;
        margin: 1em 0;
    }
</style>

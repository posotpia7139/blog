---
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getTagUrl } from "../utils/url-utils";

interface Props {
	class: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	hideTagsForMobile?: boolean;
	hideUpdateDate?: boolean;
	hideDate?: boolean;
}
const {
	published,
	updated,
	tags,
	category,
	hideTagsForMobile = false,
	hideUpdateDate = false,
	hideDate = false,
} = Astro.props;
const className = Astro.props.class;
---

<div class:list={["flex flex-col gap-2 items-start", className]}>
    <!-- First row: Dates (Non-clickable) -->
    {published && !hideDate && (
        <div class="flex flex-wrap items-center justify-start gap-4 text-black/50 dark:text-white/50">
            <div class="flex items-center">
                <div class="meta-icon">
                    <Icon name="material-symbols:edit-calendar-rounded"></Icon>
                </div>
                <span class="text-sm">{formatDateToYYYYMMDD(published)}</span>
            </div>
            {updated && updated !== published && (
                <div class="flex items-center">
                    <div class="meta-icon">
                        <Icon name="material-symbols:edit-square-outline-rounded"></Icon>
                    </div>
                    <span class="text-sm">{formatDateToYYYYMMDD(updated)}</span>
                </div>
            )}
        </div>
    )}

    <!-- Second row: Category & Tags (Clickable, 2-tier) -->
    {(category || (tags && tags.length > 0)) && (
        <div class="flex flex-col gap-2.5 w-full">
            <!-- Tier 1: Category -->
            {category && (
                <div class="flex items-center">
                    <div class="meta-icon !bg-[var(--primary)]/10 !text-[var(--primary)]">
                        <Icon name="material-symbols:folder-open-outline-rounded" class="text-base"></Icon>
                    </div>
                    <div class="flex flex-row items-center">
                        <a href={getCategoryUrl(category)} aria-label={`View all posts in the ${category} category`}
                           class="transition text-50 text-sm font-medium hover:text-[var(--primary)] whitespace-nowrap"
                        >
                            {category.split('/').map((part, i, arr) => (
                                <span class="capitalize">
                                    {part}
                                    {i < arr.length - 1 && <span class="mx-1 opacity-50 font-normal">/</span>}
                                </span>
                            ))}
                        </a>
                    </div>
                </div>
            )}

            <!-- Tier 2: Tags -->
            {tags && tags.length > 0 && (
                <div class:list={["flex items-start", {"hidden md:flex": hideTagsForMobile}]}>
                    <div class="meta-icon !bg-[var(--primary)]/10 !text-[var(--primary)]">
                        <Icon name="material-symbols:tag-rounded" class="text-base"></Icon>
                    </div>
                    <div class="flex flex-wrap items-center gap-1.5">
                        {tags.map((tag, i) => (
                            <a href={getTagUrl(tag)} aria-label={`View all posts with the ${tag} tag`}
                               class="inline-flex items-center h-6 px-3 rounded-md bg-black/5 dark:bg-white/10 text-50 text-sm font-medium hover:bg-[var(--primary)]/10 hover:text-[var(--primary)] transition-all whitespace-nowrap"
                            >
                                {tag.replaceAll(' ', '\u00A0')}
                            </a>
                        ))}
                    </div>
                </div>
            )}
        </div>
    )}
</div>

<style>
.meta-icon {
    @apply transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2 shrink-0;
}
</style>
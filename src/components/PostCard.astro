---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getTagUrl, getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts"> | CollectionEntry<"projects">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
	github_url?: string;
	demo_url?: string;
}
const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	category,
	image,
	description,
	style,
	github_url,
	demo_url,
} = Astro.props;
const className = Astro.props.class;

const isProject = entry.collection === "projects";
const hasCover = image !== undefined && image !== null && image !== "";

const coverWidth = "28%";

const { remarkPluginFrontmatter } = await entry.render();
---
<div class:list={["card-base w-full rounded-[var(--radius-large)] overflow-hidden relative group", className]} style={style}>
    {/* 전체 카드 링크 - peer로 설정하여 호버 상태를 추적함. z-index는 메타 링크(z-30)보다 낮게 설정. */}
    <a href={url} aria-label={title} class="absolute inset-0 z-20 peer"></a>

    <div class:list={["px-6 pt-6 md:px-9 md:pt-7 relative w-full", {"pb-6": !isProject, "pb-4 md:pb-5": isProject}]}>
        <div class:list={["relative mb-3", {"pr-[230px]": hasCover}]}>
            <div class="transition w-full font-semibold text-2xl md:text-3xl text-90
            title-text
            active:text-[var(--title-active)]
            relative z-10 pointer-events-none
            whitespace-nowrap overflow-hidden break-keep"
                 style={hasCover ? "mask-image: linear-gradient(to right, black 80%, transparent 100%);" : ""}
            >
                {title}
            </div>
        </div>

                    <!-- description -->
                    <div class:list={["relative z-10 pointer-events-none", {"pr-[230px]": hasCover}]}>
                        <div class:list={["transition text-75 [text-wrap:balance] break-keep text-sm md:text-base line-clamp-2", {"mb-3.5": !isProject, "mb-3": isProject}]}
                             style={hasCover ? "mask-image: linear-gradient(to right, black 90%, transparent 100%);" : ""}
                        >
                            { description || remarkPluginFrontmatter.excerpt }
                        </div>
                    </div>

        <!-- 2-tier metadata or Project Links -->
        <div class:list={["relative flex flex-col gap-2.5 pointer-events-auto", {"pr-[230px]": hasCover}]}>
            {isProject ? (
                <div class="flex items-center text-base md:text-lg meta-content w-fit pointer-events-auto text-90">
                    {github_url && (
                        <a href={github_url} target="_blank" rel="noopener" class="meta-link relative z-30 flex items-center hover:text-[var(--primary)] transition-colors group/link pl-4 pr-4 py-4 -ml-4 -my-4 gap-2">
                            <Icon name="fa6-brands:github" class="text-lg md:text-xl"></Icon>
                            <span class="font-bold">GitHub</span>
                        </a>
                    )}
                    {github_url && demo_url && (
                        <span class="mx-px text-black/20 dark:text-white/20">|</span>
                    )}
                    {demo_url && (
                        <a href={demo_url} target="_blank" rel="noopener" class="meta-link relative z-30 flex items-center hover:text-[var(--primary)] transition-colors group/link pl-4 pr-4 py-4 -my-4 gap-2">
                            <Icon name="material-symbols:open-in-new-rounded" class="text-lg md:text-xl"></Icon>
                            <span class="font-bold">Live Demo</span>
                        </a>
                    )}
                </div>
            ) : (
                <>
                    <!-- Tier 1: Category -->
                    {category && (
                        <div class:list={["flex items-center text-[13px] text-50 relative z-50"]}
                             style={hasCover ? "mask-image: linear-gradient(to right, black 80%, transparent 100%);" : ""}
                        >
                            <a href={getCategoryUrl(category)} class="meta-link relative z-50 pointer-events-auto hover:text-[var(--primary)] transition-colors pl-2 pr-2 py-3 -ml-2 -my-2 flex items-center gap-2">
                                <div class="meta-icon !bg-[var(--primary)]/10 !text-[var(--primary)] !w-6 !h-6 !mr-0 shrink-0">
                                    <Icon name="material-symbols:folder-open-outline-rounded" class="text-base"></Icon>
                                </div>
                                <div class="flex items-center">
                                    {category.split('/').map((part, i, arr) => (
                                        <>
                                            <span class="capitalize">{part}</span>
                                            {i < arr.length - 1 && <span class="mx-1 opacity-50">/</span>}
                                        </>
                                    ))}
                                </div>
                            </a>
                        </div>
                    )}
                    
                    <!-- Tier 2: Tags -->
                    {tags && tags.length > 0 && (
                        <div class:list={["flex items-center text-[12px] text-50 w-full relative z-30 pointer-events-auto"]}>
                            <div class="flex items-center overflow-hidden w-full whitespace-nowrap gap-2 pl-2 -ml-2" 
                                 style={hasCover ? "mask-image: linear-gradient(to right, black 80%, transparent 100%);" : ""}>
                                <div class="meta-icon !bg-[var(--primary)]/10 !text-[var(--primary)] !w-6 !h-6 !mr-0 shrink-0">
                                    <Icon name="material-symbols:tag-rounded" class="text-base"></Icon>
                                </div>
                                {tags.map((tag, i) => (
                                    <a href={getTagUrl(tag)} 
                                       class="inline-flex items-center h-6 px-2 rounded-md bg-black/5 dark:bg-white/10 hover:bg-[var(--primary)]/10 hover:text-[var(--primary)] transition-all whitespace-nowrap shrink-0"
                                    >
                                        {tag.replaceAll(' ', '\u00A0')}
                                    </a>
                                ))}
                            </div>
                        </div>
                    )}

                    <!-- Tier 3: word count, read time, and date -->
                    <div class:list={["text-[12px] text-black/50 dark:text-white/50 flex flex-wrap gap-y-2 gap-x-4 transition relative z-10 pointer-events-none"]}>
                        <div class="flex items-center pl-2 -ml-2">
                            <div class="meta-icon !bg-black/5 dark:!bg-white/10 !text-black/50 dark:!text-white/50 !w-6 !h-6 !mr-2 shrink-0">
                                <Icon name="material-symbols:edit-calendar-rounded" class="text-base"></Icon>
                            </div>
                            {formatDateToYYYYMMDD(published)}
                        </div>
                        <div class="flex items-center pl-2 -ml-2">
                            <div class="meta-icon !bg-black/5 dark:!bg-white/10 !text-black/50 dark:!text-white/50 !w-6 !h-6 !mr-2 shrink-0">
                                <Icon name="material-symbols:pace-rounded" class="text-base"></Icon>
                            </div>
                            {remarkPluginFrontmatter.minutes} {i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                            <span class="mx-1.5 opacity-50">/</span>
                            {remarkPluginFrontmatter.words} {i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}
                        </div>
                    </div>
                </>
            )}
        </div>

    </div>

    {hasCover && <div
                    class:list={[
                        "absolute top-6 md:top-7 right-3 rounded-xl overflow-hidden active:scale-95 z-40 pointer-events-none",
                        "aspect-square",
                        {"bottom-6": !isProject, "bottom-4 md:bottom-5": isProject}
                    ]} >
        <ImageWrapper src={image} basePath={path.join("content", entry.collection, getDir(entry.id))} alt="Cover Image of the Post"
                  class="w-full h-full object-cover">
        </ImageWrapper>
    </div>}
</div>
<div class="transition border-t-[1px] border-dashed mx-6 border-black/10 dark:border-white/[0.15] last:border-t-0 md:hidden"></div>

<style define:vars={{coverWidth}}>
    /* 바탕 링크(peer)가 호버될 때만 제목을 파란색으로 변경. */
    /* 깃허브 등 z-30 링크에 호버하면 z-20인 peer는 호버 상태가 아니게 됨. */
    .peer:hover ~ div .title-text {
        color: var(--primary);
    }
</style>
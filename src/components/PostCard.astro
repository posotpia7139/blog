---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getDir, getTagUrl } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts"> | CollectionEntry<"projects">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
	github_url?: string;
	demo_url?: string;
}
const {
	entry,
	title,
	url,
	published,
	tags,
	category,
	image,
	description,
	style,
	github_url,
	demo_url,
} = Astro.props;
const className = Astro.props.class;

const isProject = entry.collection === "projects";
const hasCover = image !== undefined && image !== null && image !== "";

const coverWidth = "28%";

const { remarkPluginFrontmatter } = await entry.render();
---
<div class:list={["card-base w-full rounded-[var(--radius-large)] overflow-hidden relative group", className]} style={style}>
    {/* 전체 카드 링크 - peer로 설정하여 호버 상태를 추적함. z-index는 메타 링크(z-30)보다 낮게 설정. */}
    <a href={url} aria-label={title} class="absolute inset-0 z-20 peer"></a>

        <div class:list={["px-6 pt-6 md:px-9 md:pt-7 relative w-full", {"pb-6": !isProject, "pb-4 md:pb-5": isProject}]}>

                    {/* 상단 영역: 제목, 설명글, 썸네일 */}

                    <div class:list={["flex-row flex items-center mb-0 md:gap-9", hasCover ? "gap-4" : "gap-0"]}>

                {/* 썸네일을 왼쪽에 배치 (프로젝트 및 블로그 포스트 모두) */}
                {hasCover && (
                    <div class:list={[
                        "shrink-0 rounded-xl overflow-hidden active:scale-95 z-40 pointer-events-none aspect-square",
                        isProject ? "w-28 h-28 md:w-40 md:h-40 self-center" : "w-28 h-28 sm:w-40 sm:h-40 self-start"
                    ]}>
                        <ImageWrapper src={image} basePath={path.join("content", entry.collection, getDir(entry.id))} alt={isProject ? "Cover of the Project" : "Cover of the Post"}
                                  widths={[200, 400]} sizes="(max-width: 640px) 112px, 160px"
                                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                        </ImageWrapper>
                    </div>
                )}

                <div class:list={["flex-1 min-w-0 flex flex-col justify-center gap-2", !hasCover && "min-h-[112px] sm:min-h-0"]}>

                    <!-- Date and Read Time (Moved Above Title) -->
                    {!isProject && (
                        <div class:list={["hidden md:flex text-[11px] md:text-[12px] text-black/75 dark:text-white/75 flex-wrap items-center gap-x-4 transition relative z-10 pointer-events-none whitespace-nowrap"]}>
                            <div class="flex items-center pl-2 -ml-2 shrink-0">
                                <div class="meta-icon !bg-black/5 dark:!bg-white/10 !text-black/75 dark:!text-white/75 !w-6 !h-6 !mr-2 shrink-0">
                                    <Icon name="material-symbols:edit-calendar-rounded" class="text-base"></Icon>
                                </div>
                                {formatDateToYYYYMMDD(published)}
                            </div>
                            <div class="flex items-center shrink-0">
                                <div class="meta-icon !bg-black/5 dark:!bg-white/10 !text-black/75 dark:!text-white/75 !w-6 !h-6 !mr-2 shrink-0">
                                    <Icon name="material-symbols:pace-rounded" class="text-base"></Icon>
                                </div>
                                {remarkPluginFrontmatter.minutes} {i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                            </div>
                        </div>
                    )}

                    <div class:list={["relative"]}>

                        <div class="transition w-full font-semibold text-lg md:text-xl text-90
                        title-text
                        active:text-[var(--title-active)]
                        relative z-10 pointer-events-none
                        line-clamp-2 [text-wrap:balance] overflow-hidden break-keep
                        leading-[1.3] md:leading-snug"
                        >

                            {title}

                        </div>

                    </div>


                    {/* description */}
                    
                    <div class:list={["relative z-10 pointer-events-none"]}>

                        <div class:list={["transition text-75 [text-wrap:balance] break-keep text-sm line-clamp-2", {"mb-2": isProject}]}

                        >

                            { description || remarkPluginFrontmatter.excerpt }

                        </div>

                    </div>
                    


                    {isProject && (

                        <div class="flex items-center text-base md:text-lg meta-content w-fit pointer-events-auto text-90 mb-1 mt-3 relative z-30">

                            {github_url && (

                                <a href={github_url} target="_blank" rel="noopener" class="meta-link relative z-30 flex items-center hover:text-[var(--primary)] transition-colors group/link pr-4 py-2 -my-2 gap-2">

                                    <Icon name="fa6-brands:github" class="text-lg md:text-xl"></Icon>

                                    <span class="font-bold text-sm md:text-base">GitHub</span>

                                </a>

                            )}

                            {github_url && demo_url && (

                                <span class="mx-px text-black/20 dark:text-white/20">|</span>

                            )}

                            {demo_url && (

                                <a href={demo_url} target="_blank" rel="noopener" class="meta-link relative z-30 flex items-center hover:text-[var(--primary)] transition-colors group/link pl-4 pr-4 py-2 -my-2 gap-2">

                                    <Icon name="material-symbols:open-in-new-rounded" class="text-lg md:text-xl"></Icon>

                                    <span class="font-bold text-sm md:text-base">Live Demo</span>

                                </a>

                            )}

                        </div>

                    )}


                    {!isProject && (

                        <div class="hidden lg:flex relative flex-col lg:gap-2 pointer-events-auto">

                            <!-- Tier 1: Category -->

                            {category && (

                                <div class:list={["hidden items-center text-[13px] text-50 relative z-50"]}

                                >

                                    <a href={getCategoryUrl(category)} class="meta-link relative z-50 pointer-events-auto hover:text-[var(--primary)] transition-colors pl-2 pr-2 py-2 -ml-2 -my-2 flex items-center gap-2">

                                        <div class="meta-icon !bg-black/5 dark:!bg-white/10 !text-black/50 dark:!text-white/50 !w-6 !h-6 !mr-0 shrink-0">

                                            <Icon name="material-symbols:folder-open-outline-rounded" class="text-base"></Icon>

                                        </div>

                                        <div class="flex items-center">

                                            {category.split('/').map((part, i, arr) => (

                                                <>

                                                    <span class="capitalize">{part}</span>

                                                    {i < arr.length - 1 && <span class="mx-1 opacity-65 font-bold">&gt;</span>}

                                                </>

                                            ))}

                                        </div>

                                    </a>

                                </div>

                            )}

                            

                            <!-- Tier 2: Tags -->
                            {tags && tags.length > 0 && (
                                <div class:list={["hidden lg:flex items-start text-[12px] text-50 w-full relative z-30 pointer-events-auto"]}>
                                    <div class="hidden items-center pl-2 -ml-2 shrink-0">
                                        <div class="meta-icon !bg-black/5 dark:!bg-white/10 !text-black/50 dark:!text-white/50 !w-6 !h-6 !mr-2 shrink-0">
                                            <Icon name="material-symbols:tag-rounded" class="text-base"></Icon>
                                        </div>
                                    </div>
                                    <div class="flex flex-wrap flex-1 gap-2 pt-0 tag-container">
                                        {tags.map((tag, i) => (
                                            <a href={getTagUrl(tag)} 
                                               class:list={[
                                                   "inline-flex items-center h-6 px-2.5 rounded-md bg-black/5 dark:bg-white/10 hover:bg-[var(--primary)]/10 hover:text-[var(--primary)] transition-all whitespace-nowrap",
                                                   {"hidden": i >= 3}
                                               ]}
                                            >
                                                {tag.replaceAll(' ', '\u00A0')}
                                            </a>
                                        ))}
                                        {tags.length > 0 && (
                                            <button 
                                                class:list={["inline-flex items-center h-6 px-2.5 rounded-md bg-black/5 dark:bg-white/10 hover:bg-black/10 dark:hover:bg-white/20 transition-all whitespace-nowrap text-[11px] font-bold show-more-tags-btn", {"hidden": tags.length <= 3}]}
                                                onclick="
                                                    const container = this.parentElement;
                                                    container.classList.add('expanded');
                                                    container.querySelectorAll('.hidden').forEach(el => el.classList.remove('hidden'));
                                                    this.style.display = 'none';
                                                "
                                            >
                                                +{tags.length - 3}
                                            </button>
                                        )}
                                    </div>
                                </div>
                            )}

                        </div>

                    )}

                </div>

            </div>

        </div>
</div>
<div class="transition border-t-[1px] border-dashed mx-6 border-black/10 dark:border-white/[0.15] last:border-t-0 first:border-t-0 md:hidden"></div>

<script>
    function setupTagTruncation() {
        const containers = document.querySelectorAll('.tag-container');
        containers.forEach(container => {
            if (container.classList.contains('expanded')) return;

            const tags = Array.from(container.querySelectorAll('a')) as HTMLElement[];
            const btn = container.querySelector('.show-more-tags-btn') as HTMLElement | null;
            const totalTags = tags.length;
            
            if (totalTags === 0) return;

            // 1. Reset: 먼저 3개까지 보이고 나머지는 숨김 (서버 사이드 상태 복원)
            tags.forEach((tag, i) => {
                tag.classList.toggle('hidden', i >= 3);
            });
            if (btn) {
                btn.style.display = '';
                btn.classList.toggle('hidden', totalTags <= 3);
                btn.innerText = `+${Math.max(0, totalTags - 3)}`;
            }

            // 2. 줄바꿈 감지 및 추가 숨김 로직
            const firstTag = tags[0];
            if (!firstTag) return;
            
            // 한 줄의 표준 높이 (미세한 오차 보정을 위해 5px 여유)
            const firstTop = firstTag.offsetTop;
            let visibleCount = tags.filter(t => !t.classList.contains('hidden')).length;

            // 반복적으로 체크하며 줄바꿈이 발생하지 않을 때까지 visibleCount를 줄임
            // 혹은 버튼이 다음 줄로 밀려난 경우에도 감지
            for (let i = tags.length - 1; i >= 0; i--) {
                const tag = tags[i];
                const needButton = totalTags > (i + 1);
                
                let isOverflowing = tag.offsetTop > (firstTop + 5);
                if (!isOverflowing && needButton && btn) {
                    // 버튼이 다음 줄로 넘어갔는지도 체크
                    if (btn.offsetTop > (firstTop + 5)) isOverflowing = true;
                }

                if (isOverflowing) {
                    tag.classList.add('hidden');
                    if (btn) {
                        btn.classList.remove('hidden');
                        btn.innerText = `+${totalTags - i}`;
                    }
                }
            }
        });
    }

    // 초기 로드, 리사이즈, Astro 페이지 이동 시 실행
    setupTagTruncation();
    window.addEventListener('resize', setupTagTruncation);
    document.addEventListener('astro:page-load', setupTagTruncation);
</script>

<style define:vars={{coverWidth}}>
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    /* 바탕 링크(peer)가 호버될 때만 제목을 파란색으로 변경. */
    /* 깃허브 등 z-30 링크에 호버하면 z-20인 peer는 호버 상태가 아니게 됨. */
    .peer:hover ~ div .title-text {
        color: var(--primary);
    }

    /* 커스텀 툴팁 스타일 */
    .custom-tooltip {
        position: relative;
    }
    .custom-tooltip::after {
        content: attr(data-tooltip);
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        padding: 0.35rem 0.6rem;
        background-color: rgba(0, 0, 0, 0.7) !important;
        color: white;
        font-size: 0.75rem;
        border-radius: 0.375rem;
        
        /* 텍스트 설정: 10자 이상 시 2~3줄 배치 및 밸런스 */
        white-space: normal;
        max-width: 10rem;
        width: max-content;
        min-width: 5rem;
        text-wrap: balance;
        word-break: keep-all;
        line-height: 1.4;
        text-align: right;

        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, transform 0.3s ease;
        transform: translateY(-4px);
        pointer-events: none;
        z-index: 100;
        backdrop-blur: 4px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    .custom-tooltip:hover::after {
        opacity: 1 !important;
        visibility: visible;
        transform: translateY(0);
    }
</style>
---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getTagUrl, getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts"> | CollectionEntry<"projects">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
	github_url?: string;
	demo_url?: string;
}
const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	category,
	image,
	description,
	style,
	github_url,
	demo_url,
} = Astro.props;
const className = Astro.props.class;

const isProject = entry.collection === "projects";
const hasCover = image !== undefined && image !== null && image !== "";

const coverWidth = "28%";

const { remarkPluginFrontmatter } = await entry.render();
---
<div class:list={["card-base w-full rounded-[var(--radius-large)] overflow-hidden relative group", className]} style={style}>
    <div class:list={["px-6 pt-6 md:px-9 md:pt-7 relative", {"w-full": !hasCover, "w-[calc(100%_-_var(--coverWidth)_-_12px)]": hasCover}, {"pb-6": !isProject, "pb-4 md:pb-5": isProject}]}>
        <div class="relative mb-3">
            <div class="transition w-full font-semibold text-2xl md:text-3xl text-90
            group-hover:text-[var(--primary)]
            active:text-[var(--title-active)]
            relative z-10 pointer-events-none
            line-clamp-1">
                {title}
            </div>
        </div>

                    <!-- description -->
                    <div class="relative z-10 pointer-events-none">
                        <div class:list={["transition text-75 pr-4 line-clamp-2 [text-wrap:balance] break-keep text-sm md:text-base", {"mb-3.5": !isProject, "mb-2": isProject}]}>
                            { description || remarkPluginFrontmatter.excerpt }
                        </div>
                    </div>

        <!-- 2-tier metadata or Project Links -->
        <div class:list={["relative z-30 flex flex-col gap-1", {"mb-4": !isProject, "mb-0": isProject}]}>
            {isProject ? (
                <div class="flex items-center gap-5 text-base md:text-lg">
                    {github_url && (
                        <a href={github_url} target="_blank" rel="noopener" class="flex items-center text-50 hover:text-[var(--primary)] transition-colors group/link">
                            <Icon name="fa6-brands:github" class="mr-2 text-lg md:text-xl"></Icon>
                            <span class="font-bold">GitHub</span>
                        </a>
                    )}
                    {demo_url && (
                        <a href={demo_url} target="_blank" rel="noopener" class="flex items-center text-50 hover:text-[var(--primary)] transition-colors group/link">
                            <Icon name="material-symbols:open-in-new-rounded" class="mr-2 text-lg md:text-xl"></Icon>
                            <span class="font-bold">Live Demo</span>
                        </a>
                    )}
                </div>
            ) : (
                <>
                    <!-- Tier 1: Category -->
                    {category && (
                        <div class="flex items-center text-[13px] text-50">
                            <Icon name="material-symbols:folder-open-outline-rounded" class="mr-1.5 text-lg text-[var(--primary)]"></Icon>
                            <div class="flex items-center">
                                <a href={getCategoryUrl(category)} class="hover:text-[var(--primary)] transition-colors">
                                    {category.split('/').map((part, i, arr) => (
                                        <>
                                            <span class="capitalize">{part}</span>
                                            {i < arr.length - 1 && <span class="mx-1 opacity-30">/</span>}
                                        </>
                                    ))}
                                </a>
                            </div>
                        </div>
                    )}
                    
                    <!-- Tier 2: Tags -->
                    {tags && tags.length > 0 && (
                        <div class="flex items-center text-[13px] text-50 w-full overflow-hidden">
                            <Icon name="material-symbols:tag-rounded" class="mr-1.5 text-lg text-[var(--primary)] shrink-0"></Icon>
                            <div class="flex truncate">
                                {tags.map((tag, i) => (
                                    <>
                                        <a href={getTagUrl(tag)} class="hover:text-[var(--primary)] transition-colors whitespace-nowrap">{tag}</a>
                                        {i < tags.length - 1 && <span class="mx-1.5 text-black/75 dark:text-white/75 font-bold">·</span>}
                                    </>
                                ))}
                            </div>
                        </div>
                    )}
                </>
            )}
        </div>

        <!-- word count, read time, and date (Hidden for Projects) -->
        {!isProject && (
            <div class="text-sm text-black/50 dark:text-white/50 flex flex-wrap gap-4 transition relative z-10 pointer-events-none">
                <div class="flex items-center">
                    <Icon name="material-symbols:edit-calendar-rounded" class="mr-1.5 text-lg"></Icon>
                    {formatDateToYYYYMMDD(published)}
                </div>
                <div class="flex items-center">
                    <Icon name="material-symbols:pace-rounded" class="mr-1.5 text-lg"></Icon>
                    {remarkPluginFrontmatter.minutes} {i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                    <span class="mx-1.5 opacity-50">/</span>
                    {remarkPluginFrontmatter.words} {i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}
                </div>
            </div>
        )}

    </div>

    {hasCover && <div
                    class:list={[
                        "w-[var(--coverWidth)] absolute top-3 bottom-3 right-3 rounded-xl overflow-hidden active:scale-95 z-10 pointer-events-none"
                    ]} >
        <ImageWrapper src={image} basePath={path.join("content", entry.collection, getDir(entry.id))} alt="Cover Image of the Post"
                  class="w-full h-full">
        </ImageWrapper>
    </div>}

    <a href={url} aria-label={title} class="absolute inset-0 z-0"></a>
</div>
<div class="transition border-t-[1px] border-dashed mx-6 border-black/10 dark:border-white/[0.15] last:border-t-0 md:hidden"></div>

<style define:vars={{coverWidth}}>
</style>

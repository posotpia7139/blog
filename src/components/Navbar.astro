---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<div id="navbar" class="z-50 relative w-full left-0 right-0">
    <div class:list={[
        className,
        "card-base !overflow-visible max-w-[var(--page-width)] h-[72px] min-h-[72px] !rounded-t-none mx-auto flex items-center justify-between px-4 md:px-6 w-full shrink-0 box-border backdrop-blur-sm gap-4"
    ]} style="background-color: color-mix(in srgb, var(--card-bg), transparent 10%);">
        
        {/* 1. 로고 영역 */}
        <a href={url('/')} class="btn-plain rounded-lg h-[52px] px-3 font-semibold active:scale-95 shrink-0">
            <div class="flex flex-row items-center text-[16px] md:text-[18px] whitespace-nowrap">
                {siteConfig.title}
            </div>
        </a>
        
        {/* 2. 메뉴 링크 영역 (중앙 좌측 정렬) */}
        <div class="hidden md:flex shrink-0 gap-4">
            {links.map((l) => {
                return <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                          class="btn-plain rounded-lg h-[44px] font-semibold px-3 active:scale-95 flex justify-center"
                >
                    <div class="flex items-center text-[15px] whitespace-nowrap">
                        {l.name}
                        {l.external && <Icon name="material-symbols:open-in-new-rounded" class="text-[18px] transition -translate-y-[1px] ml-1 text-black/50 dark:text-white/50"></Icon>}
                    </div>
                </a>;
            })}
        </div>

        {/* 3. 컨트롤 영역 (우측 고정 - 로딩 시 흔들림 방지) */}
        <div class="flex items-center shrink-0 gap-4 min-w-[104px] justify-end">
            <Search client:load></Search>
            <LightDarkSwitch client:load></LightDarkSwitch>
            <button aria-label="Menu" name="Nav Menu" class="btn-plain rounded-lg w-[48px] h-[48px] active:scale-90 lg:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[24px]"></Icon>
            </button>
        </div>

        {/* 햄버거 메뉴 패널 */}
        <div class="absolute top-[72px] right-0 z-50">
            <NavMenuPanel links={links}></NavMenuPanel>
        </div>
    </div>
</div>

<script>
function initNavbar() {
    const menuBtn = document.getElementById("nav-menu-switch");
    const menuPanel = document.getElementById("nav-menu-panel");

    if (menuBtn && menuPanel) {
        menuBtn.onclick = (e) => {
            e.stopPropagation();
            menuPanel.classList.toggle("float-panel-closed");
        };
    }
}

// 초기 로드 및 페이지 이동 후 실행
initNavbar();
document.addEventListener('astro:page-load', initNavbar);

// 페이지 이동 시작 시 메뉴 닫기
document.addEventListener('astro:before-preparation', () => {
    const menuPanel = document.getElementById("nav-menu-panel");
    if (menuPanel) menuPanel.classList.add("float-panel-closed");
});
</script>
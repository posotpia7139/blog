---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<div id="navbar" class="z-50 relative w-full left-0 right-0">
    <div class="absolute h-[32px] left-0 right-0 -top-[32px] bg-[var(--card-bg)]"></div>
    <div class:list={[
        className,
        "card-base !overflow-visible max-w-[var(--page-width)] h-[72px] min-h-[72px] !rounded-t-none mx-auto flex items-center justify-between pl-[12px] pr-[12px] md:pl-[24px] md:pr-[8px] w-full shrink-0 box-border"
    ]}>
        <a href={url('/')} class="btn-plain scale-animation rounded-lg h-[52px] px-[16px] md:px-[20px] font-semibold active:scale-95 shrink-0 min-w-fit">
            <div class="flex flex-row items-center text-[16px] md:text-[18px] whitespace-nowrap">
                {siteConfig.title}
            </div>
        </a>
        
        <div class="hidden md:flex shrink-0 gap-[4px]">
            {links.map((l) => {
                return <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                          class="btn-plain scale-animation rounded-lg h-[44px] font-semibold px-[20px] active:scale-95"
                >
                    <div class="flex items-center text-[15px]">
                        {l.name}
                        {l.external && <Icon name="material-symbols:open-in-new-rounded" class="text-[18px] transition -translate-y-[1px] ml-1 text-black/50 dark:text-white/50"></Icon>}
                    </div>
                </a>;
            })}
        </div>

        <div class="flex items-center shrink-0 gap-1 md:gap-2">
            <Search client:only="svelte"></Search>
            <LightDarkSwitch client:only="svelte"></LightDarkSwitch>
            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-[48px] h-[48px] active:scale-90 lg:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[24px]"></Icon>
            </button>
        </div>

        {/* 햄버거 메뉴 패널 */}
        <div class="absolute top-[72px] right-0 z-50">
            <NavMenuPanel links={links}></NavMenuPanel>
        </div>
    </div>
</div>

<script>
function loadButtonScript() {
    let menuBtn = document.getElementById("nav-menu-switch");
    let menuPanel = document.getElementById("nav-menu-panel");

    if (menuBtn && menuPanel) {
        menuBtn.onclick = function () {
            menuPanel.classList.toggle("float-panel-closed");
        };

        // Swup 페이지 전환 시작 시 메뉴를 무조건 닫음
        document.addEventListener('swup:visit:start', () => {
            menuPanel.classList.add("float-panel-closed");
        });
    }
}
loadButtonScript();
document.addEventListener('astro:page-load', loadButtonScript);
</script>